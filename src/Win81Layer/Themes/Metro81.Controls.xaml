      <ControlTemplate TargetType="GridViewColumnHeader">
        <Grid>
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <Path x:Name="SortArrow" Visibility="Collapsed" Data="M 0,4 L 4,0 L 8,4 Z" Fill="{TemplateBinding Foreground}" VerticalAlignment="Top" HorizontalAlignment="Center" />
          <Thumb x:Name="PART_HeaderGripper" Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Focusable="False">
