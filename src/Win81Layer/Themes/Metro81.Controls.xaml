  <Style x:Key="Metro81.Slider" TargetType="Slider" BasedOn="{StaticResource Metro81.Control}">
    <Setter Property="MinHeight" Value="40" /><Setter Property="Background" Value="#A6A6A6" /><Setter Property="Foreground" Value="{DynamicResource MenuAccent}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Metro81.SliderPage}" Background="{TemplateBinding Foreground}" /></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Metro81.SliderPage}" Background="{TemplateBinding Background}" /></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb x:Name="PART_SliderThumb" Style="{StaticResource Metro81.SliderThumb}" /></Track.Thumb>
          </Track>
          <!-- Pattern 19: a small value box appears above the thumb while dragging (the "75" in the reference). -->
          <Popup IsOpen="{Binding IsDragging, ElementName=PART_SliderThumb, Mode=OneWay}" PlacementTarget="{Binding ElementName=PART_SliderThumb}"
                 Placement="Top" VerticalOffset="-6" AllowsTransparency="True" Focusable="False" IsHitTestVisible="False">
            <Border Background="White" BorderBrush="{DynamicResource Metro81.FieldBorder}" BorderThickness="1" Padding="8,3">
              <TextBlock Foreground="Black" FontSize="14" FontFamily="Segoe UI"
                         Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" />
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Metro81.SliderThumbDark" TargetType="Thumb">
    <Setter Property="Width" Value="10" /><Setter Property="Height" Value="24" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Thumb">
        <Border x:Name="Chrome" Background="White" />
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E0E0E0" /></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C8C8C8" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#767676" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <!-- The pattern slider for DARK surfaces (charms settings, flyouts): accent fill, translucent-white remainder,
       white block thumb, same drag value box. -->
  <Style x:Key="Metro81.SliderDark" TargetType="Slider" BasedOn="{StaticResource Metro81.Control}">
    <Setter Property="MinHeight" Value="32" /><Setter Property="Background" Value="#66FFFFFF" /><Setter Property="Foreground" Value="{DynamicResource MenuAccent}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Metro81.SliderPage}" Background="{TemplateBinding Foreground}" /></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Metro81.SliderPage}" Background="{TemplateBinding Background}" /></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb x:Name="PART_SliderThumb" Style="{StaticResource Metro81.SliderThumbDark}" /></Track.Thumb>
          </Track>
          <Popup IsOpen="{Binding IsDragging, ElementName=PART_SliderThumb, Mode=OneWay}" PlacementTarget="{Binding ElementName=PART_SliderThumb}"
                 Placement="Top" VerticalOffset="-6" AllowsTransparency="True" Focusable="False" IsHitTestVisible="False">
            <Border Background="White" BorderBrush="{DynamicResource Metro81.FieldBorder}" BorderThickness="1" Padding="8,3">
              <TextBlock Foreground="Black" FontSize="14" FontFamily="Segoe UI"
                         Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" />
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Metro81.Flyout" TargetType="Border">
    <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource Metro81.FieldBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16" /><Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style x:Key="Metro81.AppBar" TargetType="Border">
    <Setter Property="Background" Value="#E5E5E5" /><Setter Property="Padding" Value="16,8" /><Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style x:Key="Metro81.ProgressRing" TargetType="ProgressBar" BasedOn="{StaticResource Metro81.ProgressBar}">
    <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ProgressBar">
        <!-- Five dots on the SAME orbit, each with its own eased rotation started a beat apart - they bunch on
             the eased sections and spread on the fast ones, the authentic Win8 ring motion. -->
        <Viewbox><Grid Width="48" Height="48">
          <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="R1" /></Grid.RenderTransform><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" /></Grid>
          <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="R2" /></Grid.RenderTransform><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" /></Grid>
          <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="R3" /></Grid.RenderTransform><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" /></Grid>
          <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="R4" /></Grid.RenderTransform><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" /></Grid>
          <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><RotateTransform x:Name="R5" /></Grid.RenderTransform><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" /></Grid>
        </Grid></Viewbox>
        <ControlTemplate.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /><Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /><Condition Binding="{Binding Path=(local:MetroControlStyles81.AnimationsEnabled), RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
            </MultiDataTrigger.Conditions>
            <MultiDataTrigger.EnterActions><BeginStoryboard Name="Spinning"><Storyboard RepeatBehavior="Forever" Duration="0:0:2.1">
              <DoubleAnimation Storyboard.TargetName="R1" Storyboard.TargetProperty="Angle" From="0" To="360" BeginTime="0:0:0" Duration="0:0:1.55"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="R2" Storyboard.TargetProperty="Angle" From="0" To="360" BeginTime="0:0:0.13" Duration="0:0:1.55"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="R3" Storyboard.TargetProperty="Angle" From="0" To="360" BeginTime="0:0:0.26" Duration="0:0:1.55"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="R4" Storyboard.TargetProperty="Angle" From="0" To="360" BeginTime="0:0:0.39" Duration="0:0:1.55"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="R5" Storyboard.TargetProperty="Angle" From="0" To="360" BeginTime="0:0:0.52" Duration="0:0:1.55"><DoubleAnimation.EasingFunction><CircleEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spinning" /></MultiDataTrigger.ExitActions>
          </MultiDataTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <!-- Command chrome only: the host supplies its icon, label, command and page/zoom behavior. -->
  <Style x:Key="Metro81.AppBarButton" TargetType="Button" BasedOn="{StaticResource Metro81.Button}">
    <Setter Property="MinWidth" Value="72" /><Setter Property="MinHeight" Value="72" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Button">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
          <StackPanel>
            <Border x:Name="Ring" Width="40" Height="40" CornerRadius="20" BorderThickness="2" BorderBrush="{TemplateBinding Foreground}" Background="{TemplateBinding Background}">
              <!-- Paint the supplied Visual's alpha, so locally white text/path brushes also invert. -->
              <Grid Width="36" Height="36" IsHitTestVisible="False">
                <Border Opacity="0">
                  <ContentPresenter x:Name="IconSource" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle x:Name="AppBarIcon" Fill="{TemplateBinding Foreground}">
                  <Rectangle.OpacityMask><VisualBrush Visual="{Binding ElementName=IconSource}" Stretch="None" AlignmentX="Center" AlignmentY="Center" /></Rectangle.OpacityMask>
                </Rectangle>
              </Grid>
            </Border>
            <TextBlock Text="{Binding Path=(local:MetroControlStyles81.Label), RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12" />
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Background" Value="#407F7F7F" /></Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Ring" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter TargetName="AppBarIcon" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Metro81.InverseInk}}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Metro81.FlipButton" TargetType="Button" BasedOn="{StaticResource Metro81.Button}">
    <Setter Property="MinWidth" Value="40" /><Setter Property="MinHeight" Value="40" /><Setter Property="Background" Value="#DDFFFFFF" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style x:Key="Metro81.SemanticZoomButton" TargetType="Button" BasedOn="{StaticResource Metro81.FlipButton}">
    <Setter Property="Content" Value="&#x2212;" /><Setter Property="FontSize" Value="24" /><Setter Property="AutomationProperties.Name" Value="Zoom out" />
  </Style>
  <Style x:Key="Metro81.Hyperlink" TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource MenuAccent}" /><Setter Property="TextDecorations" Value="Underline" />
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource MenuAccentPressed}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Metro81.DisabledInk}" /></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
