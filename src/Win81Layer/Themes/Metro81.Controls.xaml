  <Style x:Key="Metro81.ProgressBar" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource MenuAccent}" /><Setter Property="Background" Value="#DEDEDE" /><Setter Property="Height" Value="8" />
    <Setter Property="local:MetroControlStyles81.AnimationsEnabled" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
          <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
          <UniformGrid x:Name="Dots" Rows="1" Width="90" HorizontalAlignment="Center" Visibility="Collapsed">
            <Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" /><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" /><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" /><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" /><Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" />
            <UniformGrid.RenderTransform><TranslateTransform x:Name="Motion" /></UniformGrid.RenderTransform>
          </UniformGrid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_Track" Property="Background" Value="Transparent" /><Setter TargetName="Dots" Property="Visibility" Value="Visible" /></Trigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /><Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /><Condition Binding="{Binding Path=(local:MetroControlStyles81.AnimationsEnabled), RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
            </MultiDataTrigger.Conditions>
            <MultiDataTrigger.EnterActions><BeginStoryboard Name="Moving"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="X" From="-70" To="70" Duration="0:0:1.6" AutoReverse="True" /></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="Moving" /></MultiDataTrigger.ExitActions>
          </MultiDataTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
