  <!-- Retain the native header parts for resize, auto-size and floating column drag visuals. -->
  <Style x:Key="Metro81.GridViewColumnHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource Metro81.Control}">
    <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#CCCCCC" />
