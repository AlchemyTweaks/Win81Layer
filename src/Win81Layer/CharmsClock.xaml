<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Win81Layer.CharmsClock" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clock" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" Focusable="False" ShowActivated="False" IsHitTestVisible="False" SizeToContent="WidthAndHeight" xmlns:win81layer="clr-namespace:Win81Layer;assembly=Win81Layer">
