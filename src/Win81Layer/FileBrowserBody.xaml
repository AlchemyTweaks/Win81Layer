<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Win81Layer.FileBrowserBody"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFFFF"
             FontFamily="Segoe UI"
             FontSize="12"
             Foreground="#FF111111"
             Focusable="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             PreviewKeyDown="OnPreviewKeyDown">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ExplorerBlue" Color="#FF0067B9" />
    <SolidColorBrush x:Key="ExplorerHeading" Color="#FF1F4E98" />
    <SolidColorBrush x:Key="ExplorerHover" Color="#FFE5F3FB" />
    <SolidColorBrush x:Key="ExplorerSelected" Color="#FFCDE8F6" />
    <SolidColorBrush x:Key="ExplorerBorder" Color="#FFD6D6D6" />

    <Style x:Key="ExplorerFlatButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF111111" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFE5F3FB" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF70C0E7" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFCDE8F6" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2C96C9" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExplorerNavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ExplorerFlatButton}">
      <Setter Property="Width" Value="29" />
      <Setter Property="Height" Value="29" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,1,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExplorerTabButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ExplorerFlatButton}">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExplorerCommandButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ExplorerFlatButton}">
      <Setter Property="MinWidth" Value="70" />
      <Setter Property="Height" Value="60" />
      <Setter Property="Margin" Value="2,4" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExplorerBreadcrumbButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ExplorerFlatButton}">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ExplorerTreeItem" TargetType="{x:Type TreeViewItem}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FF111111" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TreeViewItem}">
            <StackPanel>
              <Border x:Name="Row" Height="23" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="Expander" Grid.Column="0" Width="16" Height="22" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                    <Path x:Name="Arrow" Data="M 5,4 L 10,8 L 5,12 Z" Fill="#FF666666" Stretch="None" RenderTransformOrigin="0.5,0.5" />
                  </ToggleButton>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                <Setter TargetName="Arrow" Property="RenderTransform">
                  <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#FFF0F0F0" />
                <Setter TargetName="Row" Property="BorderBrush" Value="#FFD8D8D8" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#FFF7F7F7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExplorerListItem" TargetType="{x:Type ListViewItem}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListViewItem}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" Content="{TemplateBinding Content}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFE5F3FB" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF70C0E7" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFCDE8F6" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2C96C9" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExplorerIconListItem" TargetType="{x:Type ListViewItem}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListViewItem}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFE5F3FB" /><Setter TargetName="Bd" Property="BorderBrush" Value="#FF70C0E7" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFCDE8F6" /><Setter TargetName="Bd" Property="BorderBrush" Value="#FF2C96C9" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type GridViewColumnHeader}">
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="#FFE2E2E2" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFF1F8FC" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExplorerContextMenu" TargetType="{x:Type ContextMenu}">
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="Foreground" Value="#FF111111" />
      <Setter Property="BorderBrush" Value="#FF9B9B9B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <DataTemplate x:Key="NameCellTemplate">
      <StackPanel Orientation="Horizontal" Height="24" Loaded="FileRow_Loaded">
        <Image Width="20" Height="20" Margin="1,0,7,0" Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LargeIconRowTemplate">
      <Grid Height="58" Loaded="FileRow_Loaded">
        <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="48" Height="48" Margin="4" Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
          <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding TypeText}" Foreground="#FF666666" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExplorerFolderTemplate">
      <Border Width="272" Height="56" Margin="0,1,10,1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" PreviewMouseLeftButtonDown="ThisPcItem_MouseLeftButtonDown" PreviewMouseRightButtonUp="ThisPcItem_MouseRightButtonUp" SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal">
          <Image Width="48" Height="48" Margin="8,3,10,3" Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
          <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ExplorerDriveTemplate">
      <Border Width="272" Height="61" Margin="0,1,10,1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" PreviewMouseLeftButtonDown="ThisPcItem_MouseLeftButtonDown" PreviewMouseRightButtonUp="ThisPcItem_MouseRightButtonUp" SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Grid.Column="0" Width="48" Height="48" Margin="6,5,4,6" Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,1,6,0">
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Height="12" Margin="0,3,0,2" Minimum="0" Maximum="100" Value="{Binding UsagePercent}" Foreground="#FF26A0DA" Background="#FFE6E6E6" BorderBrush="#FFB7B7B7" BorderThickness="1" />
            <TextBlock Text="{Binding SecondaryText}" Foreground="#FF666666" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="28" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="38" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#FFE5E5E5" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="FileTab" Content="File" Click="FileTab_Click" Style="{StaticResource ExplorerTabButton}" Background="#FF0067B9" Foreground="#FFFFFFFF" />
          <Button x:Name="ComputerTab" Content="Computer" Click="ComputerTab_Click" Style="{StaticResource ExplorerTabButton}" />
          <Button x:Name="ViewTab" Content="View" Click="ViewTab_Click" Style="{StaticResource ExplorerTabButton}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CollapseRibbonButton" Width="28" Height="27" Padding="0" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="Expand or collapse the ribbon" Click="CollapseRibbonButton_Click" Style="{StaticResource ExplorerFlatButton}" />
          <Button Width="28" Height="27" Padding="0" Content="?" Foreground="#FF0067B9" FontSize="14" FontWeight="Bold" ToolTip="Help" Click="HelpButton_Click" Style="{StaticResource ExplorerFlatButton}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="RibbonHost" Grid.Row="1" Height="0" Visibility="Collapsed" Background="#FFF9F9F9" BorderBrush="#FFD8D8D8" BorderThickness="0,0,0,1" ClipToBounds="True" Opacity="0">
      <Grid>
        <StackPanel x:Name="ComputerCommands" Orientation="Horizontal" Margin="8,0">
          <Button Style="{StaticResource ExplorerCommandButton}" Click="RibbonProperties_Click"><StackPanel><Image Width="24" Height="24" Source="pack://application:,,,/Assets/win81icons/explorer81/properties-16.png" RenderOptions.BitmapScalingMode="NearestNeighbor" /><TextBlock Text="Properties" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Style="{StaticResource ExplorerCommandButton}" Click="RibbonOpen_Click"><StackPanel><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FF2672EC" HorizontalAlignment="Center" /><TextBlock Text="Open" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Style="{StaticResource ExplorerCommandButton}" Click="RibbonNewFolder_Click"><StackPanel><Image Width="28" Height="28" Source="pack://application:,,,/Assets/win81icons/explorer81/folder-48.png" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="New folder" Margin="0,1,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Style="{StaticResource ExplorerCommandButton}" Click="RibbonRename_Click"><StackPanel><TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FF2672EC" HorizontalAlignment="Center" /><TextBlock Text="Rename" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
        <StackPanel x:Name="ViewCommands" Orientation="Horizontal" Margin="8,0" Visibility="Collapsed">
          <Button Style="{StaticResource ExplorerCommandButton}" Click="DetailsView_Click"><StackPanel><Image Width="24" Height="24" Source="pack://application:,,,/Assets/win81icons/explorer81/view-details-16.png" RenderOptions.BitmapScalingMode="NearestNeighbor" /><TextBlock Text="Details" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Style="{StaticResource ExplorerCommandButton}" Click="IconsView_Click"><StackPanel><Image Width="24" Height="24" Source="pack://application:,,,/Assets/win81icons/explorer81/view-icons-16.png" RenderOptions.BitmapScalingMode="NearestNeighbor" /><TextBlock Text="Large icons" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Style="{StaticResource ExplorerCommandButton}" Click="RibbonRefresh_Click"><StackPanel><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FF2672EC" HorizontalAlignment="Center" /><TextBlock Text="Refresh" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Style="{StaticResource ExplorerCommandButton}" Click="NavigationPane_Click"><StackPanel><TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FF2672EC" HorizontalAlignment="Center" /><TextBlock Text="Navigation pane" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Background="#FFF8F8F8" Margin="10,4,10,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="202" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
        <Button x:Name="BackButton" Style="{StaticResource ExplorerNavButton}" ToolTip="Back" Click="BackButton_Click"><TextBlock Text="&#xE112;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#FF5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
        <Button x:Name="ForwardButton" Style="{StaticResource ExplorerNavButton}" ToolTip="Forward" Click="ForwardButton_Click"><TextBlock Text="&#xE111;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#FF5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
        <Button x:Name="UpButton" Style="{StaticResource ExplorerNavButton}" ToolTip="Up" Click="UpButton_Click"><TextBlock Text="&#xE110;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#FF5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
      </StackPanel>
      <Border x:Name="AddressBorder" Grid.Column="1" Background="#FFFFFFFF" BorderBrush="#FFB8B8B8" BorderThickness="1" PreviewMouseLeftButtonDown="AddressBorder_PreviewMouseLeftButtonDown">
        <Grid>
          <StackPanel x:Name="BreadcrumbHost" Orientation="Horizontal" Margin="4,0,28,0" VerticalAlignment="Center" ClipToBounds="True" />
          <TextBox x:Name="AddressBox" Visibility="Collapsed" BorderThickness="0" Background="#FFFFFFFF" Padding="5,2" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostKeyboardFocus" />
          <Button HorizontalAlignment="Right" Width="27" Height="25" Padding="0" ToolTip="Refresh" Click="RefreshButton_Click" Style="{StaticResource ExplorerFlatButton}"><Path Data="M 4,8 A 5,5 0 1 1 6,12 M 4,8 L 4,3 M 4,8 L 9,8" Stroke="#FF777777" StrokeThickness="1.2" Fill="Transparent" Stretch="None" /></Button>
        </Grid>
      </Border>
      <Border Grid.Column="2" Margin="9,0,0,0" Background="#FFFFFFFF" BorderBrush="#FFB8B8B8" BorderThickness="1">
        <Grid>
          <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="6,2,27,2" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
          <TextBlock x:Name="SearchPlaceholder" Text="Search This PC" Margin="7,0,28,0" Foreground="#FF777777" IsHitTestVisible="False" VerticalAlignment="Center" />
          <Path HorizontalAlignment="Right" Margin="0,0,8,0" Data="M 2,2 A 4,4 0 1 1 1.9,2 M 6,6 L 10,10" Stroke="#FF777777" StrokeThickness="1.4" Stretch="None" IsHitTestVisible="False" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#FFE4E4E4" />

    <Grid Grid.Row="4" Background="#FFFFFFFF">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavigationColumn" Width="166" />
        <ColumnDefinition x:Name="NavigationSplitterColumn" Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TreeView x:Name="NavigationTree" Grid.Column="0" Background="#FFFFFFFF" BorderThickness="0" Padding="8,10,0,0" ItemContainerStyle="{StaticResource ExplorerTreeItem}" SelectedItemChanged="NavigationTree_SelectedItemChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      <Border x:Name="NavigationSplitter" Grid.Column="1" Background="#FFE5E5E5" />

      <Grid x:Name="ContentHost" Grid.Column="2" Background="#FFFFFFFF">
        <ScrollViewer x:Name="ThisPcView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#FFFFFFFF">
          <StackPanel Margin="10,9,8,8">
            <Grid Height="24">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="&#x25BE;  Folders (6)" Foreground="{StaticResource ExplorerHeading}" FontSize="14" VerticalAlignment="Center" />
              <Border Grid.Column="1" Height="1" Margin="8,3,0,0" Background="#FFE5E5E5" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl x:Name="FolderItems" ItemTemplate="{StaticResource ExplorerFolderTemplate}" Margin="2,0,0,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid Height="24">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock x:Name="DrivesHeading" Grid.Column="0" Text="&#x25BE;  Devices and drives (0)" Foreground="{StaticResource ExplorerHeading}" FontSize="14" VerticalAlignment="Center" />
              <Border Grid.Column="1" Height="1" Margin="8,3,0,0" Background="#FFE5E5E5" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl x:Name="DriveItems" ItemTemplate="{StaticResource ExplorerDriveTemplate}" Margin="2,0,0,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ListView x:Name="FileList" Visibility="Collapsed" Background="#FFFFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource ExplorerListItem}" SelectionMode="Extended" MouseDoubleClick="FileList_MouseDoubleClick" PreviewMouseRightButtonUp="FileList_PreviewMouseRightButtonUp" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
          <ListView.View>
            <GridView x:Name="DetailsGridView">
              <GridViewColumn Header="Name" Width="300" CellTemplate="{StaticResource NameCellTemplate}" />
              <GridViewColumn Header="Date modified" Width="150" DisplayMemberBinding="{Binding DateModifiedText}" />
              <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding TypeText}" />
              <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
            </GridView>
          </ListView.View>
        </ListView>

        <Border x:Name="EmptyState" Visibility="Collapsed" Background="#FFFFFFFF">
          <TextBlock x:Name="EmptyStateText" Text="This folder is empty." Foreground="#FF666666" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#DFFFFFFF">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar Width="150" Height="8" IsIndeterminate="True" Style="{DynamicResource Metro81.ProgressBar}" Foreground="{DynamicResource MenuAccent}" BorderThickness="0" />
            <TextBlock Text="Working on it..." Margin="0,8,0,0" Foreground="#FF555555" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="5" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
      <Grid Margin="10,0,7,0">
        <TextBlock x:Name="StatusText" Text="0 items" VerticalAlignment="Center" Foreground="#FF444444" FontSize="11" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Width="22" Height="20" Padding="2" ToolTip="Details" Click="DetailsView_Click" Style="{StaticResource ExplorerFlatButton}"><Image Source="pack://application:,,,/Assets/win81icons/explorer81/view-details-16.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Button>
          <Button Width="22" Height="20" Padding="2" ToolTip="Large icons" Click="IconsView_Click" Style="{StaticResource ExplorerFlatButton}"><Image Source="pack://application:,,,/Assets/win81icons/explorer81/view-icons-16.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
