<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Win81Layer.StartScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Win81Layer" Title="Start" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="False" Background="#FF101010" Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource MetroContextMenu}">
        <EventSetter Event="Closed" Handler="OnAnyContextMenuClosed" />
      </Style>
      <Style x:Key="SelectionPill" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Background="{TemplateBinding Control.Background}" />
                <Border Name="Ov" Background="#00FFFFFF" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Ov" Property="Border.Background" Value="#28FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <!-- Pattern press-invert on the dark bar: solid white plate, black label. -->
                  <Setter TargetName="Ov" Property="Border.Background" Value="#FFFFFFFF" />
                  <Setter Property="Foreground" Value="#FF000000" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <SolidColorBrush x:Key="SearchAccent" Color="#6A2C91" />
      <SolidColorBrush x:Key="SortBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SortBorder" Color="#B4B4B4" />
      <SolidColorBrush x:Key="SortHighlight" Color="#E8E8E8" />
      <SolidColorBrush x:Key="SortSelected" Color="#6A2C91" />
      <Style x:Key="SortMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Background="{DynamicResource SortBg}" BorderBrush="{DynamicResource SortBorder}" BorderThickness="1" Padding="0,4" RenderTransformOrigin="0.2,0">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="7" ShadowDepth="1.5" Direction="290" Opacity="0.22" Color="Black" />
                </UIElement.Effect>
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="MenuScale" ScaleY="1" />
                </UIElement.RenderTransform>
                <FrameworkElement.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.11" />
                        <DoubleAnimation Storyboard.TargetName="MenuScale" Storyboard.TargetProperty="ScaleY" From="0.88" To="1" Duration="0:0:0.13">
                          <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </FrameworkElement.Triggers>
                <ItemsPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SortMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#1A1A1A" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Border Name="Bd" Background="#00FFFFFF" Padding="16,6" MinWidth="180">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="MenuItem.IsHighlighted" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource SortHighlight}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="MenuItem.IsChecked" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource SortSelected}" Property="Border.Background" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CircleIconButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Ellipse Name="Circle" Stroke="#AAFFFFFF" StrokeThickness="2" Fill="#00FFFFFF" />
                <TextBlock Text="{TemplateBinding ContentControl.Content}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Circle" Property="Shape.Fill" Value="#22FFFFFF" />
                  <Setter TargetName="Circle" Property="Shape.Stroke" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HeaderIconButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="#00FFFFFF">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#22FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#33FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TileButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Root" RenderTransformOrigin="0.5,0.5" Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" Background="{Binding Entry.TileBrush}">
                <UIElement.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PressNudge" X="0" Y="0" />
                  </TransformGroup>
                </UIElement.RenderTransform>
                <Grid>
                  <Image Name="TileIcon" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding Entry.Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" />
                  <Image Name="FolderFace" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" Width="{Binding FolderFaceSize}" Height="{Binding FolderFaceSize}" local:TileFx.AnimatedSource="{Binding FolderIcon}" />
                  <Border Name="OverrideBg" Visibility="Collapsed" Background="{Binding Entry.OverrideBrush}" />
                  <Image Name="OverrideFace" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Entry.Icon}" Width="{Binding OverrideFaceSize}" Height="{Binding OverrideFaceSize}" />
                  <TextBlock Name="TileName" Margin="12,0,12,9" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding Entry.Name}" />
                  <Grid Name="LiveFlipHost" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Loaded="OnLiveContentLoaded" Unloaded="OnLiveContentUnloaded">
                    <UIElement.RenderTransform>
                      <ScaleTransform x:Name="LiveFlip" ScaleY="1" />
                    </UIElement.RenderTransform>
                    <StackPanel Name="LiveContentFace" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10">
                      <TextBlock FontFamily="Segoe UI Light" FontSize="42" Foreground="#FFFFFFFF" Text="{Binding LivePrimary}" />
                      <TextBlock FontFamily="Segoe UI" FontSize="14" Foreground="#DDFFFFFF" Margin="2,-4,0,0" Text="{Binding LiveSecondary}" />
                    </StackPanel>
                    <Grid Name="LiveIconFace" Visibility="Collapsed">
                      <TextBlock Name="LiveGlyphText" FontFamily="Segoe MDL2 Assets" FontSize="46" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8" Text="{Binding LiveGlyph}" />
                      <Image Name="LiveIconImg" Visibility="Collapsed" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8" Width="{Binding LiveIconSize}" Height="{Binding LiveIconSize}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding LiveIcon}" />
                      <TextBlock Name="LiveLogoLabel" FontFamily="Segoe UI" FontSize="13" Foreground="#DDFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Text="{Binding Entry.Name}" />
                    </Grid>
                  </Grid>
                  <Grid Name="MetroFlipHost" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Loaded="OnMetroContentLoaded" Unloaded="OnLiveContentUnloaded">
                    <UIElement.RenderTransform>
                      <ScaleTransform x:Name="WeatherFlip" ScaleY="1" />
                    </UIElement.RenderTransform>
                    <local:MetroTilePresenter Name="WeatherFace" Visual="{Binding MetroVisual}" MotionEnabled="{Binding MetroMotionEnabled}" />
                    <Grid Name="WeatherLogoFace" Visibility="Collapsed">
                      <TextBlock Name="WeatherLogoGlyph" FontFamily="Segoe MDL2 Assets" FontSize="46" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8" Text="{Binding LiveGlyph}" />
                      <Image Name="WeatherLogoImg" Visibility="Collapsed" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8" Width="{Binding LiveIconSize}" Height="{Binding LiveIconSize}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding LiveIcon}" />
                      <TextBlock Name="WeatherLogoLabel" FontFamily="Segoe UI" FontSize="13" Foreground="#F2FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Text="{Binding Entry.Name}" />
                    </Grid>
                  </Grid>
                  <TextBlock FontFamily="Segoe UI Symbol" FontSize="26" Foreground="#F2FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" IsHitTestVisible="False" Text="{Binding LiveSymbol}" />
                  <Image Name="DesktopSmallFace" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding DesktopSmallIcon}" />
                  <Border Name="HoverOverlay" Background="#20FFFFFF" Visibility="Collapsed" />
                  <Border Name="FocusBorder" BorderBrush="#FFFFFFFF" BorderThickness="2" Visibility="Collapsed" />
                  <Border Name="SelectBorder" BorderBrush="#FF2672EC" BorderThickness="3" Visibility="Collapsed" />
                  <Border Name="SelectCheck" Width="26" Height="26" Background="#FF2672EC" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsLive}">
                  <Setter TargetName="TileIcon" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="TileName" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="LiveFlipHost" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsMetroLiveTile}">
                  <Setter TargetName="TileIcon" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="TileName" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="LiveFlipHost" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsMetroFaceVisible}">
                  <Setter TargetName="TileIcon" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="TileName" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="LiveFlipHost" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="MetroFlipHost" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding HasLiveIcon}">
                  <Setter TargetName="LiveGlyphText" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="LiveIconImg" Property="Visibility" Value="Visible" />
                  <Setter TargetName="WeatherLogoGlyph" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="WeatherLogoImg" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsFolder}">
                  <Setter TargetName="TileIcon" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="FolderFace" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding Entry.IsOverrideIcon}">
                  <Setter TargetName="TileIcon" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="OverrideBg" Property="Visibility" Value="Visible" />
                  <Setter TargetName="OverrideFace" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsSmall}">
                  <Setter TargetName="TileName" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="WeatherLogoLabel" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="LiveLogoLabel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDesktop}" Value="True" />
                    <Condition Binding="{Binding IsSmall}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="DesktopSmallFace" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsSelected}">
                  <Setter TargetName="SelectBorder" Property="Visibility" Value="Visible" />
                  <Setter TargetName="SelectCheck" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsDragging}">
            <Setter Property="UIElement.Opacity" Value="0.5" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="AppListButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Root" Width="248" Height="44" Background="#00FFFFFF" Padding="6">
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="32" Height="32">
                      <Border Background="{Binding TileBrush}" />
                      <Border Name="ListOverrideBg" Visibility="Collapsed" Background="{Binding OverrideBrush}" />
                      <Image Name="ListIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding Icon}" />
                    </Grid>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="150" Text="{Binding Name}" />
                    <TextBlock Text="new" FontFamily="Segoe UI" FontSize="11" Foreground="#FF6CB8FF" VerticalAlignment="Center" Margin="6,0,0,0">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsNew}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </StackPanel>
                  <Border Name="SelCheck" Width="20" Height="20" Background="{DynamicResource SearchAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,2,0" Visibility="Collapsed">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsOverrideIcon}">
                  <Setter TargetName="ListOverrideBg" Property="Visibility" Value="Visible" />
                  <Setter TargetName="ListIcon" Property="Width" Value="32" />
                  <Setter TargetName="ListIcon" Property="Height" Value="32" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsSelected}">
                  <Setter TargetName="Root" Value="{DynamicResource HoverTint}" Property="Border.Background" />
                  <Setter TargetName="SelCheck" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource HoverTint}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource HoverTint}" Property="Border.Background" />
                  <Setter TargetName="Root" Property="Border.BorderBrush" Value="#66FFFFFF" />
                  <Setter TargetName="Root" Property="Border.BorderThickness" Value="1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ResultRowButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Root" Background="#00FFFFFF" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource HoverTint}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource HoverTint}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PersonalizeAction" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#EEFFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Ab" Background="#22FFFFFF" Padding="12,7">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Ab" Value="{DynamicResource HoverTint}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ZoomLetterButton" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Root" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Root" Value="{DynamicResource ZoomHover}" Property="Border.Background" />
                </MultiTrigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Root" Value="{DynamicResource ZoomHover}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="RootGrid" RenderTransformOrigin="0.5,0.5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="56" />
    </Grid.RowDefinitions>
    <Border Name="BgLayer" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="-1" Margin="0,0,-160,0" Background="{StaticResource StartBackground}">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="BgParallax" X="0" />
      </UIElement.RenderTransform>
    </Border>
    <Border Name="SelectionBar" Grid.Row="0" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,0" Background="#F2111111" CornerRadius="0" Padding="14,8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <TextBlock Name="SelectionCount" Text="0 selected" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Content="New group" Cursor="Hand" Style="{StaticResource SelectionPill}" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource MenuAccent}" BorderThickness="0" Padding="12,4" Margin="0,0,8,0" FocusVisualStyle="{x:Null}" Click="OnGroupSelected" />
        <Button Content="Unpin" Cursor="Hand" Style="{StaticResource SelectionPill}" Foreground="#FFFFFFFF" FontFamily="Segoe UI" FontSize="14" Background="#33FFFFFF" BorderThickness="0" Padding="12,4" Margin="0,0,8,0" FocusVisualStyle="{x:Null}" Click="OnUnpinSelected" />
        <Button Content="Clear" Cursor="Hand" Style="{StaticResource SelectionPill}" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="14" Background="#00FFFFFF" BorderThickness="0" Padding="8,4" FocusVisualStyle="{x:Null}" Click="OnClearSelection" />
      </StackPanel>
    </Border>
    <Grid Name="HeaderBar" Row="0" Margin="80,40,60,24">
      <StackPanel Orientation="Horizontal">
        <TextBlock Name="HeaderText" Text="Start" FontFamily="Segoe UI Light" FontSize="42" Foreground="{StaticResource StartForeground}" />
        <StackPanel Name="SortDropdown" Orientation="Horizontal" Margin="18,0,0,12" VerticalAlignment="Bottom" Background="#00FFFFFF" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="OnSortLabelClick">
          <TextBlock Name="SortLabel" Text="by name" FontFamily="Segoe UI" FontSize="14" Foreground="#99FFFFFF" />
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#99FFFFFF" Margin="6,4,0,0" />
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Grid Name="SearchGroup" Width="270" Height="38" VerticalAlignment="Center" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="38" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#FFFFFFFF" BorderThickness="2">
            <Border.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="BorderBrush" Value="#767676" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SearchAccent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <TextBox Name="SearchBox" FontFamily="Segoe UI" FontSize="15" Background="#00FFFFFF" Foreground="#1A1A1A" CaretBrush="#1A1A1A" BorderThickness="0" Padding="10,0,30,0" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" GotKeyboardFocus="OnSearchFocusChanged" LostKeyboardFocus="OnSearchFocusChanged" />
              <TextBlock Name="SearchWatermark" Text="Search apps" IsHitTestVisible="False" Foreground="#767676" FontFamily="Segoe UI" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0" />
              <Button Name="SearchClear" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" FocusVisualStyle="{x:Null}" Click="OnSearchClear">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="XBd" Width="24" Height="24" CornerRadius="0" Background="#00FFFFFF">
                      <TextBlock Name="XGlyph" Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <!-- Pattern 14: the clear-X hover is an accent plate with a white glyph. -->
                        <Setter TargetName="XBd" Property="Border.Background" Value="{DynamicResource SearchAccent}" />
                        <Setter TargetName="XGlyph" Property="TextBlock.Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </Grid>
          </Border>
          <Button Grid.Column="1" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnSearchButtonClick">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="GoBg" Background="{DynamicResource SearchAccent}">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="GoBg" Property="UIElement.Opacity" Value="0.85" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
        </Grid>
        <StackPanel Name="StartHeaderButtons" Orientation="Horizontal">
          <TextBlock Name="UserNameText" FontFamily="Segoe UI" FontSize="18" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Name="UserTile" Width="40" Height="40" Margin="0,0,8,0" Cursor="Hand" ToolTip="Account: Lock, Sign out, Settings" FocusVisualStyle="{x:Null}" Click="OnUserTileClick">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="Bd" Background="#33FFFFFF">
                  <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Border.Background" Value="#55FFFFFF" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
          <Button Name="AutoArrangeButton" Style="{StaticResource HeaderIconButton}" Margin="0,0,2,0" VerticalAlignment="Center" ToolTip="Auto-organize tiles" Click="OnAutoArrange">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Name="PowerButton" Style="{StaticResource HeaderIconButton}" Margin="0,0,2,0" VerticalAlignment="Center" ToolTip="Power: Sleep, Shut down, Restart" Click="OnPowerClick">
            <Path Data="M17.36,6.64 A9,9 0 1 1 4.64,6.64M11,1 L11,13" Stretch="None" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Button>
          <Button Name="SearchButton" Style="{StaticResource HeaderIconButton}" Margin="0,0,0,0" VerticalAlignment="Center" ToolTip="Search" Click="OnHeaderSearchClick">
            <Path Data="M8,8 A7,7 0 1 1 22,8A7,7 0 1 1 8,8M10.05,12.95 L1.56,21.44" Stretch="None" Stroke="#FFFFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
    <ScrollViewer Name="StartScroller" Grid.Row="1" Margin="80,0,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnBandWheel">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="StartViewSlide" />
      </UIElement.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <ItemsControl Name="GroupsHost" KeyboardNavigation.DirectionalNavigation="Continue">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:GroupVm}">
              <StackPanel Margin="0,0,72,0">
                <Border Height="34" MinWidth="150" Background="#00FFFFFF" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Double-click to rename  ·  right-click for more" MouseLeftButtonDown="OnGroupHeaderMouseDown">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsEditing}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <FrameworkElement.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Launch all apps" Click="OnLaunchAllInGroup" />
                      <MenuItem Header="Save window layout" Click="OnSaveGroupLayout" />
                      <MenuItem Header="Restore layout" Click="OnRestoreGroupLayout" />
                      <MenuItem Header="Pin workspace to Start" Click="OnPinWorkspaceTile" />
                      <Separator />
                      <MenuItem Header="Name group" Click="OnRenameGroup" />
                      <MenuItem Header="New group to the right" Click="OnNewGroupAfter" />
                      <Separator />
                      <MenuItem Header="Move group left" Click="OnMoveGroupLeft" />
                      <MenuItem Header="Move group right" Click="OnMoveGroupRight" />
                      <Separator />
                      <MenuItem Header="Remove empty group" Click="OnDeleteGroup" />
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                  <Grid>
                    <TextBlock Name="GroupNameText" FontFamily="Segoe UI" FontWeight="Light" FontSize="20" Foreground="#CCFFFFFF" Text="{Binding Name}" />
                    <TextBlock Name="GroupNamePrompt" Text="Name group" FontFamily="Segoe UI" FontWeight="Light" FontSize="20" Foreground="#66FFFFFF" IsHitTestVisible="False" Visibility="Collapsed">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding NamePromptVisible}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                  </Grid>
                </Border>
                <!-- Win8.1 group rename (spec image): white 44px input, 2px cyan focus border, square corners, cyan check + outlined X, "Enter to save . Esc to cancel". Shown only while editing. -->
                <StackPanel Name="GroupEditPanel" HorizontalAlignment="Left" Margin="0,1,0,8">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsEditing}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBox Name="GroupNameEdit" FontFamily="Segoe UI" FontSize="22" Height="44" MinWidth="240" MaxWidth="520" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="10,0" Background="#FFFFFFFF" Foreground="#FF1A1A1A" CaretBrush="#FF1A1A1A" SelectionBrush="{DynamicResource MenuAccent}" SelectionOpacity="0.4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="OnGroupEditVisibleChanged" KeyDown="OnGroupNameEditKeyDown" LostFocus="OnGroupNameEditLostFocus">
                      <TextBox.Template>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#FF767676" BorderThickness="2" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource MenuAccent}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </TextBox.Template>
                    </TextBox>
                    <Border Width="44" Height="44" Margin="8,0,0,0" Background="{DynamicResource MenuAccent}" Cursor="Hand" SnapsToDevicePixels="True" ToolTip="Save (Enter)" MouseLeftButtonDown="OnGroupRenameCommit">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="{DynamicResource MenuAccentLight}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock Text="&#x2713;" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>
                    <Border Width="44" Height="44" Margin="8,0,0,0" Background="Transparent" BorderBrush="#66FFFFFF" BorderThickness="2" Cursor="Hand" SnapsToDevicePixels="True" ToolTip="Cancel (Esc)" MouseLeftButtonDown="OnGroupRenameCancel">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="BorderBrush" Value="#B3FFFFFF" />
                              <Setter Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock Text="&#x2715;" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>
                  </StackPanel>
                  <TextBlock Margin="2,8,0,0" FontFamily="Segoe UI" FontSize="13" Foreground="#9E92C6" Text="Enter to save   ·   Esc to cancel" />
                </StackPanel>
                <ItemsControl Background="#00FFFFFF" KeyboardNavigation.DirectionalNavigation="Continue" ItemsSource="{Binding Tiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <local:TilePanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ContentPresenter}">
                      <Setter Property="local:TilePanel.Cols" Value="{Binding Cols}" />
                      <Setter Property="local:TilePanel.Rows" Value="{Binding Rows}" />
                      <Setter Property="local:TilePanel.Col" Value="{Binding Col}" />
                      <Setter Property="local:TilePanel.Row" Value="{Binding Row}" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TileVm}">
                      <Button Style="{StaticResource TileButton}" Click="OnTileClick" PreviewMouseLeftButtonDown="OnTilePress" PreviewMouseMove="OnTileMove" PreviewMouseLeftButtonUp="OnTileUp" PreviewMouseRightButtonUp="OnTileRightClick" MouseDown="OnTileMiddleDown" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Name="NewGroupZone" Width="90" Margin="0,34,0,10" Background="#00FFFFFF">
          <Border Name="NewGroupVisual" Width="74" Background="#22FFFFFF" Opacity="0">
            <TextBlock Text="+" FontFamily="Segoe UI Light" FontSize="40" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Canvas Name="DragOverlay" Grid.Row="1" IsHitTestVisible="False">
      <Border Name="DropPreview" Visibility="Collapsed" Background="#33FFFFFF" BorderBrush="#F0FFFFFF" BorderThickness="2.5" CornerRadius="1" CacheMode="BitmapCache">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.7" Color="White" />
        </UIElement.Effect>
        <TextBlock Name="DropFoldGlyph" Text="" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#FFFFFFFF" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Canvas>
    <ScrollViewer Name="AppsScroller" Grid.Row="1" Margin="80,0,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Hidden" PreviewMouseWheel="OnBandWheel">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="AppsViewSlide" />
      </UIElement.RenderTransform>
      <local:AppsColumnsPanel x:Name="AppsHost" KeyboardNavigation.DirectionalNavigation="Continue" />
    </ScrollViewer>
    <Border Name="AppsZoomOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#D8070710" Visibility="Collapsed">
      <WrapPanel Name="AlphabetGrid" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" />
    </Border>
    <Border Name="ZoomOverlay" Grid.Row="1" Grid.RowSpan="2" Background="#D8070710" Visibility="Collapsed" MouseRightButtonUp="OnZoomBackgroundClick" MouseLeftButtonUp="OnZoomBackgroundClick">
      <local:AnimatedBar x:Name="ZoomHost" Margin="80,20,60,20" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Canvas Name="ZoomDragLayer" Grid.Row="1" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed" />
    <local:MetroDirectionalArrow81 x:Name="ViewToggle" Grid.Row="2" Width="42" Height="42" GlyphSize="32" Direction="Down" Margin="80,0,0,14" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" ToolTip="Show all apps" AutomationProperties.Name="Show all apps" Click="OnViewToggle">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="ViewToggleSlide" Y="10" />
      </UIElement.RenderTransform>
    </local:MetroDirectionalArrow81>
    <ScrollBar Name="BottomScroll" Orientation="Horizontal" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="40" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,18,0" Height="15" Opacity="0" Focusable="False" IsTabStop="False" Style="{StaticResource Metro81.ScrollBar}" Visibility="Collapsed" Scroll="OnBottomScroll" />
    <Button Name="ZoomOutBtn" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="42" Width="18" Height="{Binding Height, ElementName=BottomScroll}" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Arrow" ToolTip="Zoom out" AutomationProperties.Name="Semantic zoom" Visibility="Collapsed" Click="OnZoomOutButton">
      <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource Metro81.ScrollZoomButton}">
          <Setter Property="Opacity" Value="{Binding Opacity, ElementName=BottomScroll}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Visibility, ElementName=ZoomVBar}" Value="Visible"><Setter Property="Opacity" Value="1" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Rectangle Width="8" Height="1.4" RadiusX="0.7" RadiusY="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Rectangle Name="ZoomVBar" Width="1.4" Height="8" RadiusX="0.7" RadiusY="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Grid>
    </Button>
    <Border Name="TileAppBar" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="55" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="92" Background="#F5262626" BorderThickness="0,1,0,0" Visibility="Collapsed">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="TileAppBarSlide" Y="92" />
      </UIElement.RenderTransform>
      <Grid VerticalAlignment="Center" Margin="20,0,20,0">
        <StackPanel Name="TileAppBarCommands" Orientation="Horizontal" HorizontalAlignment="Left" />
        <StackPanel Name="TileAppBarCustomise" Orientation="Horizontal" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Grid Name="PersonalizeHost" Row="0" RowSpan="3" ZIndex="60" Visibility="Collapsed">
      <Border Name="PersonalizeBackdrop" Background="#01000000" MouseLeftButtonDown="OnPersonalizeBackdropClick" />
      <Border Name="PersonalizePane" Width="392" HorizontalAlignment="Right" Background="#F21A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1,0,0,0">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="PersonalizeSlide" X="392" />
        </UIElement.RenderTransform>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="20,22,14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <local:MetroDirectionalArrow81 x:Name="PersonalizeBack" Width="36" Height="36" GlyphSize="28" Direction="Left" Margin="0,0,8,0" ToolTip="Back" AutomationProperties.Name="Back" Click="OnPersonalizeClose" />
              <TextBlock Text="Personalize" Foreground="#FFFFFFFF" FontFamily="Segoe UI Light" FontSize="26" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Cursor="Hand" Foreground="#CCFFFFFF" FontFamily="Segoe MDL2 Assets" FontSize="13" ToolTip="Close" FocusVisualStyle="{x:Null}" Click="OnPersonalizeClose">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Name="Xb" Background="#00FFFFFF" CornerRadius="17">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="Xb" Property="Border.Background" Value="#22FFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="26,6,16,20">
            <StackPanel>
              <TextBlock Text="BACKGROUND" Foreground="#88FFFFFF" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8" />
              <WrapPanel Name="DesignGrid" />
              <TextBlock Text="OR A PICTURE" Foreground="#88FFFFFF" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Margin="0,20,0,8" />
              <WrapPanel Name="PatternGrid" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Choose a picture…" Style="{StaticResource PersonalizeAction}" Margin="0,0,8,0" Click="OnChooseStartPicture" />
                <Button Content="Desktop wallpaper" Style="{StaticResource PersonalizeAction}" Click="OnUseDesktopBg" />
              </StackPanel>
              <TextBlock Text="BACKGROUND COLOR" Foreground="#88FFFFFF" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8" />
              <WrapPanel Name="BgColorGrid" Width="338" HorizontalAlignment="Left" />
              <Border Name="BgHueStrip" Height="15" Width="338" Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonDown="OnBgHueClick">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0000" Offset="0" />
                    <GradientStop Color="#FFFF00" Offset="0.17" />
                    <GradientStop Color="#00FF00" Offset="0.33" />
                    <GradientStop Color="#00FFFF" Offset="0.5" />
                    <GradientStop Color="#0000FF" Offset="0.67" />
                    <GradientStop Color="#FF00FF" Offset="0.83" />
                    <GradientStop Color="#FF0000" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <TextBlock Text="ACCENT COLOR" Foreground="#88FFFFFF" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8" />
              <Button Name="AccentAutoBtn" HorizontalAlignment="Left" Margin="0,0,0,8" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnAccentAuto">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="Ab" Background="#22FFFFFF" Padding="10,6" CornerRadius="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Name="AbGlyph" Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#EEFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Match Start theme" Foreground="#EEFFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Ab" Value="{DynamicResource HoverTint}" Property="Border.Background" />
                      </Trigger>
                      <Trigger Property="FrameworkElement.Tag" Value="active">
                        <Setter TargetName="Ab" Value="{DynamicResource SearchAccent}" Property="Border.Background" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
              <WrapPanel Name="AccentColorGrid" Width="338" HorizontalAlignment="Left" />
              <Border Name="AccentHueStrip" Height="15" Width="338" Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonDown="OnAccentHueClick">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0000" Offset="0" />
                    <GradientStop Color="#FFFF00" Offset="0.17" />
                    <GradientStop Color="#00FF00" Offset="0.33" />
                    <GradientStop Color="#00FFFF" Offset="0.5" />
                    <GradientStop Color="#0000FF" Offset="0.67" />
                    <GradientStop Color="#FF00FF" Offset="0.83" />
                    <GradientStop Color="#FF0000" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
