        <Button Name="VolumeButton" Style="{StaticResource TrayIcon}" ToolTip="{Binding VolumeTip}" Click="OnVolumeClick" MouseWheel="OnVolumeWheel" MouseRightButtonUp="OnVolumeRightClick">
          <Grid>
            <Image Name="VolumeIcon81" Width="{DynamicResource TB.Win81TrayIconSize}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding TrayVolumeImage}" Opacity="{DynamicResource TB.SystemGlyphOpacity}" Visibility="{Binding VolumeImageVis}" />
            <TextBlock Name="VolumeGlyphText" Text="{Binding VolumeGlyph}" Visibility="{Binding VolumeGlyphVis}" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource TB.GlyphSize}" Foreground="{DynamicResource TB.GlyphInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Name="BatteryButton" Style="{StaticResource TrayIcon}" Content="{Binding BatteryGlyph}" ToolTip="{Binding BatteryTip}" Visibility="{Binding BatteryVisible, Converter={StaticResource B2V}}" Click="OnBatteryClick" MouseRightButtonUp="OnBatteryRightClick" />
        <Popup Name="VolumePopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" PlacementTarget="{Binding ElementName=VolumeButton}" Opened="OnVolumePopupOpened" Closed="OnVolumePopupClosed">
          <Border Name="VolumeFlyoutRoot" Width="376" Height="480" Background="#00000000" BorderBrush="{DynamicResource TB.SoundBorder}" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
            <Border.RenderTransform>
              <TranslateTransform x:Name="VolumeFlyoutSlide" />
            </Border.RenderTransform>
            <Grid Background="{DynamicResource TB.SoundBackground}">
              <Grid.RowDefinitions>
                <RowDefinition x:Name="VolumeHeaderRow" Height="124" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="VolumeFooterRow" Height="104" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource TB.SoundHeader}" Padding="15,9,15,8" BorderBrush="#2AFFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="VolumeTitle" Text="Volume" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI Light" FontSize="26" VerticalAlignment="Center" />
                    <TextBlock Name="VolumePercent" Grid.Column="1" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI Light" FontSize="38" VerticalAlignment="Center">
                      <Run Text="{Binding VolumePct, Mode=OneWay}" />
                      <Run Text="%" FontSize="18" />
                    </TextBlock>
                  </Grid>
                  <TextBlock Name="VolDeviceName" Grid.Row="1" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,-2,0,3" />
                  <Grid Grid.Row="2" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Speaker SCALES to fill its row (Viewbox, Stretch=Uniform, capped 34) so it is ALWAYS whole and as large
                         as the row allows — never clipped and never a sliver, whatever header height the code picks or DPI does.
                         The button stretches to the row; its Padding gives the icon breathing room. -->
                    <Button Name="MuteToggle" Grid.Column="0" Style="{StaticResource FlyoutGlyph}" Width="52" Padding="6,3" VerticalAlignment="Stretch" Click="OnMuteToggle" ToolTip="Mute or unmute">
                      <Viewbox Stretch="Uniform" MaxHeight="34" MaxWidth="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="40" Height="40">
                          <Image Name="VolumeHeroImage" Source="{Binding VolumeImage}" Visibility="{Binding VolumeImageVis}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <TextBlock Name="MuteToggleGlyph" Text="{Binding VolumeGlyph}" Visibility="{Binding VolumeGlyphVis}" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource TB.Ink}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False" TextOptions.TextFormattingMode="Ideal" />
                        </Grid>
                      </Viewbox>
                    </Button>
                    <Slider Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Style="{StaticResource MetroSlider}" VerticalAlignment="Center" Margin="12,0,3,0" Value="{Binding VolumePct, Mode=TwoWay}" ValueChanged="OnVolumeSliderChanged" />
                  </Grid>
                </Grid>
              </Border>
              <ScrollViewer Name="VolumeBodyScroll" Grid.Row="1" ScrollChanged="OnFlyoutBodyScrollChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" IsManipulationEnabled="True" Padding="12,6,9,5" PanningMode="VerticalOnly" PanningDeceleration="0.0025" PanningRatio="1.0">
                <ScrollViewer.Resources>
                  <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Background" Value="{DynamicResource Metro81.ScrollTrackBrushDark}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                          <Grid Background="{DynamicResource Metro81.ScrollTrackBrushDark}" SnapsToDevicePixels="True">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                              <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                              </Track.DecreaseRepeatButton>
                              <Track.Thumb>
                                <Thumb Focusable="False" Cursor="Hand">
                                  <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                      <Grid Background="Transparent">
                                        <Border Name="ThumbVisual" Width="5" Background="{DynamicResource Metro81.ScrollThumbBrushDark}" HorizontalAlignment="Center" />
                                      </Grid>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                                          <Setter TargetName="ThumbVisual" Property="Border.Background" Value="{DynamicResource Metro81.ScrollThumbHoverBrushDark}" />
                                        </Trigger>
                                        <Trigger Property="Thumb.IsDragging" Value="True">
                                          <Setter TargetName="ThumbVisual" Property="Border.Background" Value="{DynamicResource Metro81.ScrollThumbPressedBrushDark}" />
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Thumb.Template>
                                </Thumb>
                              </Track.Thumb>
                              <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                              </Track.IncreaseRepeatButton>
                            </Track>
                          </Grid>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ScrollViewer.Resources>
                <StackPanel Name="VolumeBodyPanel">
                  <Grid Margin="0,0,0,5">
                    <TextBlock Text="Output" Foreground="{DynamicResource TB.HeadInk}" FontFamily="Segoe UI Semilight" FontSize="14" />
                    <TextBlock Name="VolumeRefreshStatus" Text="Updating..." Foreground="#B8FFFFFF" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />
                  </Grid>
                  <StackPanel Name="OutputList" />
                  <TextBlock Text="Input" Foreground="{DynamicResource TB.HeadInk}" FontFamily="Segoe UI Semilight" FontSize="14" Margin="0,6,0,4" />
                  <StackPanel Name="InputList" />
                  <TextBlock Name="AppsHeader" Text="App volume" Foreground="{DynamicResource TB.HeadInk}" FontFamily="Segoe UI Semilight" FontSize="14" Margin="0,6,0,4" />
                  <TextBlock Name="VolumeEmptyApps" Text="No active audio apps" Foreground="#A8FFFFFF" FontFamily="Segoe UI" FontSize="12" Margin="2,3,0,8" Visibility="Collapsed" />
                  <ItemsControl Name="AppVolumeHost">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="SessionCard" Height="56" Margin="0,0,0,4" Background="{DynamicResource TB.SoundApp}" BorderBrush="#22FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="44" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Background="#26000000">
                              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="20" Foreground="#D8FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Image Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                                <Image.Source>
                                  <MultiBinding Converter="{StaticResource RestIconEdge}">
                                    <Binding Path="Icon" />
                                    <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                                  </MultiBinding>
                                </Image.Source>
                              </Image>
                            </Grid>
                            <Grid Grid.Column="1" Margin="10,4,7,4">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                              </Grid.RowDefinitions>
                              <TextBlock Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                              <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="14" Style="{StaticResource FlyoutGlyph}" Padding="3,0" Content="{Binding MuteGlyph}" Click="OnAppMuteClick" ToolTip="Mute or unmute app" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" Style="{StaticResource MetroSlider}" Margin="8,0,2,0" Value="{Binding VolumePct, Mode=TwoWay}" />
                              </Grid>
                            </Grid>
                            <TextBlock Grid.Column="2" Foreground="#E8FFFFFF" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <Run Text="{Binding VolumePct, Mode=OneWay}" /><Run Text=" %" />
                            </TextBlock>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Name}" Value="System sounds">
                            <Setter TargetName="SessionCard" Property="Border.Background" Value="{DynamicResource TB.SoundSystemApp}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <!-- more below: the last 16 DIP of the body fade into the footer (not over the scrollbar); shown only while scrollable -->
              <Rectangle Name="VolumeBodyFade" Grid.Row="1" Height="16" VerticalAlignment="Bottom" Margin="0,0,14,0" Fill="{DynamicResource TB.SoundFooter}" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#FF000000" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.OpacityMask>
              </Rectangle>
              <Border Grid.Row="2" Background="{DynamicResource TB.SoundFooter}" BorderBrush="#32FFFFFF" BorderThickness="0,1,0,0" Padding="11,6,11,4">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25" />
                  </Grid.RowDefinitions>
                  <Grid Name="SoundActionGrid">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
