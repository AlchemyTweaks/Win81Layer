<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Win81Layer.TaskbarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Win81Layer" Title="Win81 Taskbar" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowsTransparency="True" Background="#FF1F1F1F" MouseRightButtonUp="OnTaskbarRightClick">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="B2V" />
      <SolidColorBrush x:Key="TB.Accent" Color="#8AB4F8" />
      <!-- The ink of the clock and of the clock, volume and network flyouts. Dark rest swaps in its soft ink in code. -->
      <SolidColorBrush x:Key="TB.Ink" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TB.DayInk" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="TB.ChevronInk" Color="#F2FFFFFF" />
      <!-- More inks Dark rest swaps in code (TaskbarWindow.ApplyTaskbarInk): the tray glyphs and running-app labels, the
           volume section headers, the toolbar chevron, the address box outline, the selected calendar day, and the
           volume slider's track and its outline. -->
      <SolidColorBrush x:Key="TB.GlyphInk" Color="#EEFFFFFF" />
      <SolidColorBrush x:Key="TB.HeadInk" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="TB.InkSoft" Color="#BBFFFFFF" />
      <SolidColorBrush x:Key="TB.AddressBorder" Color="#55FFFFFF" />
      <SolidColorBrush x:Key="TB.DaySelectedInk" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="TB.SliderTrack" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="TB.SliderTrackBorder" Color="#00FFFFFF" />
      <local:RestIconEdgeConverter x:Key="RestIconEdge" />
      <SolidColorBrush x:Key="TB.AccentDim" Color="#B48AB4F8" />
      <SolidColorBrush x:Key="TB.StartSurface" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="TB.StartSurfaceHover" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="TB.StartSurfacePressed" Color="#FF000000" />
      <SolidColorBrush x:Key="TB.StartFrame" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="TB.StartFramePressed" Color="#FF000000" />
      <SolidColorBrush x:Key="TB.ClockBackground" Color="#FF07345F" />
      <SolidColorBrush x:Key="TB.ClockHeader" Color="#FF0865B8" />
      <SolidColorBrush x:Key="TB.ClockBody" Color="#FF09315B" />
      <SolidColorBrush x:Key="TB.ClockFooter" Color="#FF092F58" />
      <SolidColorBrush x:Key="TB.ClockBorder" Color="#FF0B72C4" />
      <SolidColorBrush x:Key="TB.ClockLink" Color="#FF67BCFF" />
      <SolidColorBrush x:Key="TB.ClockSelection" Color="#FF078FF0" />
      <SolidColorBrush x:Key="TB.SoundBackground" Color="#FF07345F" />
      <SolidColorBrush x:Key="TB.SoundHeader" Color="#FF084A85" />
      <SolidColorBrush x:Key="TB.SoundFooter" Color="#FF052D55" />
      <SolidColorBrush x:Key="TB.SoundBorder" Color="#FF0B72C4" />
      <SolidColorBrush x:Key="TB.SoundLink" Color="#FF45B7FF" />
      <SolidColorBrush x:Key="TB.SoundOutputDefault" Color="#FF078FEF" />
      <SolidColorBrush x:Key="TB.SoundOutputOther" Color="#FF0A4D83" />
      <SolidColorBrush x:Key="TB.SoundInputDefault" Color="#FF743EC4" />
      <SolidColorBrush x:Key="TB.SoundInputOther" Color="#FF236F73" />
      <!-- The outline of the default and of the other device rows (Dark rest gives the other rows the control outline). -->
      <SolidColorBrush x:Key="TB.SoundRowEdgeDefault" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="TB.SoundRowEdgeOther" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="TB.SoundApp" Color="#FF0D8EA5" />
      <SolidColorBrush x:Key="TB.SoundSystemApp" Color="#FF0A9A83" />
      <SolidColorBrush x:Key="TB.SoundPlaybackTile" Color="#FF078FEF" />
      <SolidColorBrush x:Key="TB.SoundRecordingTile" Color="#FF6637B6" />
      <SolidColorBrush x:Key="TB.SoundSoundsTile" Color="#FF35A952" />
      <SolidColorBrush x:Key="TB.SoundSettingsTile" Color="#FF0759A9" />
      <SolidColorBrush x:Key="TB.NetworkBackground" Color="#FF07345F" />
      <SolidColorBrush x:Key="TB.NetworkHeader" Color="#FF084A85" />
      <SolidColorBrush x:Key="TB.NetworkFooter" Color="#FF052D55" />
      <SolidColorBrush x:Key="TB.NetworkBorder" Color="#FF0B72C4" />
      <SolidColorBrush x:Key="TB.NetworkLink" Color="#FF45B7FF" />
      <SolidColorBrush x:Key="TB.NetworkState" Color="#B72A5D8B" />
      <SolidColorBrush x:Key="TB.NetworkWifiTile" Color="#FF078FEF" />
      <SolidColorBrush x:Key="TB.NetworkConnectionsTile" Color="#FF086DBD" />
      <SolidColorBrush x:Key="TB.NetworkTroubleshootTile" Color="#FF743EC4" />
      <DataTemplate x:Key="TrayIconTemplate" DataType="{x:Type local:TrayAppIcon}">
        <Button Cursor="Hand" AllowDrop="True" FocusVisualStyle="{x:Null}" ToolTip="{Binding Tooltip}" Click="OnAppIconClick" MouseRightButtonUp="OnAppIconRightClick" PreviewMouseLeftButtonDown="OnTrayIconPreviewMouseDown" PreviewMouseLeftButtonUp="OnTrayIconPreviewMouseUp" PreviewMouseMove="OnTrayIconPreviewMouseMove" LostMouseCapture="OnTrayIconLostCapture" MouseDown="OnTrayIconMouseDown" MouseUp="OnTrayIconMouseUp" PreviewKeyDown="OnTrayIconKeyDown" DragOver="OnTrayDragOver" Drop="OnTrayIconDrop">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Name="Bd" Background="#00FFFFFF" Padding="0" MinWidth="{DynamicResource TB.TraySlotWidth}" MinHeight="{DynamicResource TB.TraySlotWidth}">
                  <Grid>
                    <Image Name="IconImg" Width="{DynamicResource TB.TrayAppIconSize}" Height="{DynamicResource TB.TrayAppIconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                      <Image.Source>
                        <MultiBinding Converter="{StaticResource RestIconEdge}">
                          <Binding Path="Image" />
                          <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                      </Image.Source>
                    </Image>
                    <ContentPresenter Name="HostHolder" Content="{Binding HostElement}" Visibility="Collapsed" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Name="HintL" Width="2" Margin="0,3" HorizontalAlignment="Left" Background="{DynamicResource MenuAccent}" Visibility="Collapsed" />
                <Border Name="HintR" Width="2" Margin="0,3" HorizontalAlignment="Right" Background="{DynamicResource MenuAccent}" Visibility="Collapsed" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#22FFFFFF" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding HasHost}">
                  <Setter TargetName="IconImg" Property="UIElement.Visibility" Value="Collapsed" />
                  <Setter TargetName="HostHolder" Property="UIElement.Visibility" Value="Visible" />
                  <Setter TargetName="Bd" Property="Border.Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Value="1" Binding="{Binding DropHint}">
                  <Setter TargetName="HintL" Property="UIElement.Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="2" Binding="{Binding DropHint}">
                  <Setter TargetName="HintR" Property="UIElement.Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="PinnedButtonTemplate" DataType="{x:Type local:PinItem}">
        <Button Cursor="Hand" Width="48" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Click="OnPinnedClick" MouseRightButtonUp="OnPinnedRightClick" PreviewMouseLeftButtonDown="OnPinnedDragStart" PreviewMouseMove="OnPinnedDragMove" PreviewMouseLeftButtonUp="OnPinnedDragEnd" MouseEnter="OnTaskbarBtnEnter" MouseLeave="OnTaskbarBtnLeave">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="#00FFFFFF" Height="{DynamicResource TB.BarHeight}">
                <Grid>
                  <Image Width="{DynamicResource TB.IconSize}" Height="{DynamicResource TB.IconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                    <Image.Source>
                      <MultiBinding Converter="{StaticResource RestIconEdge}">
                        <Binding Path="Icon" />
                        <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                  <StackPanel Name="Ind" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed">
                    <Border Name="Seg1" Height="3" Width="22" Background="{DynamicResource TB.AccentDim}" />
                    <Border Name="Seg2" Height="3" Width="0" Background="{DynamicResource TB.AccentDim}" />
                  </StackPanel>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsRunning}">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnRunning}" />
                  <Setter TargetName="Ind" Property="UIElement.Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnHover}" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding MultiInstance}">
                  <Setter TargetName="Seg1" Property="FrameworkElement.Width" Value="10" />
                  <Setter TargetName="Seg2" Property="FrameworkElement.Width" Value="10" />
                  <Setter TargetName="Seg2" Property="FrameworkElement.Margin" Value="3,0,0,0" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsForeground}">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnActive}" />
                  <Setter TargetName="Seg1" Value="{DynamicResource TB.Accent}" Property="Border.Background" />
                  <Setter TargetName="Seg2" Value="{DynamicResource TB.Accent}" Property="Border.Background" />
                </DataTrigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnPressed}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="TaskButtonTemplate" DataType="{x:Type local:TaskWindow}">
        <Button Cursor="Hand" MaxWidth="200" FocusVisualStyle="{x:Null}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" Click="OnTaskClick" MouseRightButtonUp="OnTaskRightClick" MouseEnter="OnTaskbarBtnEnter" MouseLeave="OnTaskbarBtnLeave">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{DynamicResource TB.BtnRunning}" Height="{DynamicResource TB.BarHeight}">
                <Grid>
                  <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <Image Width="{DynamicResource TB.IconSize}" Height="{DynamicResource TB.IconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                      <Image.Source>
                        <MultiBinding Converter="{StaticResource RestIconEdge}">
                          <Binding Path="Icon" />
                          <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                      </Image.Source>
                    </Image>
                    <TextBlock Foreground="{DynamicResource TB.GlyphInk}" FontFamily="Segoe UI" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Visibility="{Binding ShowLabel, Converter={StaticResource B2V}}" />
                  </StackPanel>
                  <Border Name="Ul" Height="3" Background="{DynamicResource TB.AccentDim}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6,0,6,2" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnHover}" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsForeground}">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnActive}" />
                  <Setter TargetName="Ul" Value="{DynamicResource TB.Accent}" Property="Border.Background" />
                </DataTrigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnPressed}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
      <Style x:Key="{x:Type CalendarDayButton}" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="#EEFFFFFF" />
      </Style>
      <Style x:Key="{x:Type CalendarButton}" TargetType="{x:Type CalendarButton}">
        <Setter Property="Foreground" Value="#EEFFFFFF" />
      </Style>
      <Style x:Key="DeviceRow" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Background" Value="#FF0A4D83" />
        <Setter Property="BorderBrush" Value="#24FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="0.91" Property="UIElement.Opacity" />
                  <Setter TargetName="Bd" Value="#55FFFFFF" Property="Border.BorderBrush" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Value="0.78" Property="UIElement.Opacity" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroSoundActionTile" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
        <Setter Property="Background" Value="#FF078FEF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Name="TileSurface" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="#22FFFFFF" BorderThickness="1" />
                <Border Name="HoverLayer" Background="#20FFFFFF" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="#66FFFFFF" />
                  <Setter TargetName="HoverLayer" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="TileSurface" Property="UIElement.Opacity" Value="0.82" />
                  <Setter TargetName="TileSurface" Property="UIElement.RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX="0.975" ScaleY="0.975" /></Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- at most 26 DIP; in the compact footers it shrinks so the label row (Auto) is never clipped -->
      <Style x:Key="MetroSoundActionIcon" TargetType="{x:Type Viewbox}">
        <Setter Property="MaxWidth" Value="26" />
        <Setter Property="MaxHeight" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <!-- the shared stroke chevron (MenuGlyphs.Chevron, 6x10, 1.5 stroke, round caps), as in the menus -->
      <Style x:Key="MetroSoundActionChevron" TargetType="{x:Type Path}">
        <Setter Property="Data" Value="{x:Static local:MenuGlyphs.Chevron}" />
        <Setter Property="Stroke" Value="{DynamicResource TB.ChevronInk}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
      <Style x:Key="MetroSoundFooterLink" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.SoundLink}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" Padding="8,5">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#20FFFFFF" />
                  <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#38FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroTrayCommandButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
        <Setter Property="Background" Value="#14000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Name="CommandSurface" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <Border Name="HoverLayer" Background="#00FFFFFF" />
                <Border BorderBrush="#2EFFFFFF" BorderThickness="0,0,0,1" />
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="HoverLayer" Property="Border.Background" Value="#24FFFFFF" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="CommandSurface" Property="UIElement.Opacity" Value="0.76" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroTrayCommandIcon" TargetType="{x:Type Viewbox}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <Style x:Key="FlyoutLink" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TaskbarLink}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="#00FFFFFF" Padding="6,3" CornerRadius="2">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource TaskbarHover}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FlyoutGlyph" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="#EEFFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="2" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource TaskbarHover}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroCalendarDay" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.DayInk}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#28FFFFFF" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#50FFFFFF" />
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroClockSettings" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.ClockLink}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#1FFFFFFF" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#38FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroSlider" TargetType="{x:Type Slider}">
        <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid Height="24" VerticalAlignment="Center">
                <!-- Unfilled track: was #59FFFFFF (35% white) which read as a faint line on the dark flyout; raised to
                     ~60% white and 3px so the bar is clearly visible in every state (shared by the main + per-app sliders). -->
                <Border Height="8" Background="{DynamicResource TB.SliderTrack}" VerticalAlignment="Center" />
                <Border Height="8" BorderBrush="{DynamicResource TB.SliderTrackBorder}" BorderThickness="1" VerticalAlignment="Center" />
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" OverridesDefaultStyle="True">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Height="8" Background="{DynamicResource TB.Accent}" VerticalAlignment="Center" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" OverridesDefaultStyle="True">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Focusable="False" OverridesDefaultStyle="True">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Rectangle Width="10" Height="24" Fill="{DynamicResource TB.Ink}" />
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TrayGlyph" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TB.GlyphInk}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="{DynamicResource TB.GlyphSize}" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="#00FFFFFF" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.GlyphHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.GlyphPressed}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Tray status buttons (overflow chevron, network, volume, battery, Action Center): ONE slot shared with the app
           icons (TB.TraySlotWidth = 1.5 x the native tray frame, set per bar by ApplyTrayIconMetrics). No padding: the 1:1
           tray canvas or glyph is centred over the full bar height, so every icon shares the bar's centre line. -->
      <Style x:Key="TrayIcon" TargetType="{x:Type Button}" BasedOn="{StaticResource TrayGlyph}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="{DynamicResource TB.TraySlotWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource TB.TraySlotWidth}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="RootLayout" Background="#00FFFFFF" AllowDrop="True" DragOver="OnPinDragOver" Drop="OnPinFileDrop">
