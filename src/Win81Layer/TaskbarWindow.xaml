<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Win81Layer.TaskbarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Win81Layer" Title="Win81 Taskbar" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowsTransparency="True" Background="#FF1F1F1F" MouseRightButtonUp="OnTaskbarRightClick">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="B2V" />
      <SolidColorBrush x:Key="TB.Accent" Color="#8AB4F8" />
      <!-- The ink of the clock and of the clock, volume and network flyouts. Dark rest swaps in its soft ink in code. -->
      <SolidColorBrush x:Key="TB.Ink" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TB.DayInk" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="TB.ChevronInk" Color="#F2FFFFFF" />
      <!-- More inks Dark rest swaps in code (TaskbarWindow.ApplyTaskbarInk): the tray glyphs and running-app labels, the
           volume section headers, the toolbar chevron, the address box outline, the selected calendar day, and the
           volume slider's track and its outline. -->
      <SolidColorBrush x:Key="TB.GlyphInk" Color="#EEFFFFFF" />
      <SolidColorBrush x:Key="TB.HeadInk" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="TB.InkSoft" Color="#BBFFFFFF" />
      <SolidColorBrush x:Key="TB.AddressBorder" Color="#55FFFFFF" />
      <SolidColorBrush x:Key="TB.DaySelectedInk" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="TB.SliderTrack" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="TB.SliderTrackBorder" Color="#00FFFFFF" />
      <local:RestIconEdgeConverter x:Key="RestIconEdge" />
      <SolidColorBrush x:Key="TB.AccentDim" Color="#B48AB4F8" />
      <SolidColorBrush x:Key="TB.StartSurface" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="TB.StartSurfaceHover" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="TB.StartSurfacePressed" Color="#FF000000" />
      <SolidColorBrush x:Key="TB.StartFrame" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="TB.StartFramePressed" Color="#FF000000" />
      <!-- The clock and volume flyouts: the Action Center's surface (body gradient, footer band, frame, contrast-raised link),
           rewritten by ApplyClockCalendarTheme / ApplySoundFlyoutTheme from the same tones (ActionCenter.NormalTones). -->
      <SolidColorBrush x:Key="TB.ClockBackground" Color="#FF07345F" />
      <SolidColorBrush x:Key="TB.ClockBody" Color="#FF09315B" />
      <SolidColorBrush x:Key="TB.ClockFooter" Color="#FF092F58" />
      <SolidColorBrush x:Key="TB.ClockBorder" Color="#FF0B72C4" />
      <SolidColorBrush x:Key="TB.ClockLink" Color="#FF67BCFF" />
      <SolidColorBrush x:Key="TB.ClockSelection" Color="#FF078FF0" />
      <SolidColorBrush x:Key="TB.SoundBackground" Color="#FF07345F" />
      <SolidColorBrush x:Key="TB.SoundFooter" Color="#FF052D55" />
      <SolidColorBrush x:Key="TB.SoundBorder" Color="#FF0B72C4" />
      <SolidColorBrush x:Key="TB.SoundLink" Color="#FF45B7FF" />
      <!-- The shared quiet tokens of both flyouts: the footer divider, the hover / keyboard-focus and pressed washes, the
           value ink (percentages, the date) and the secondary ink (weekdays, counts, a footer message). Dark rest swaps them. -->
      <SolidColorBrush x:Key="TB.FlyoutDivider" Color="#32FFFFFF" />
      <SolidColorBrush x:Key="TB.FlyoutHover" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="TB.FlyoutPressed" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="TB.FlyoutValueInk" Color="#E8FFFFFF" />
      <SolidColorBrush x:Key="TB.FlyoutSecondaryInk" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="TB.NetworkBackground" Color="#FF07345F" />
      <SolidColorBrush x:Key="TB.NetworkHeader" Color="#FF084A85" />
      <SolidColorBrush x:Key="TB.NetworkFooter" Color="#FF052D55" />
      <SolidColorBrush x:Key="TB.NetworkBorder" Color="#FF0B72C4" />
      <SolidColorBrush x:Key="TB.NetworkLink" Color="#FF45B7FF" />
      <SolidColorBrush x:Key="TB.NetworkState" Color="#B72A5D8B" />
      <SolidColorBrush x:Key="TB.NetworkWifiTile" Color="#FF078FEF" />
      <SolidColorBrush x:Key="TB.NetworkConnectionsTile" Color="#FF086DBD" />
      <SolidColorBrush x:Key="TB.NetworkTroubleshootTile" Color="#FF743EC4" />
      <DataTemplate x:Key="TrayIconTemplate" DataType="{x:Type local:TrayAppIcon}">
        <Button Cursor="Hand" AllowDrop="True" FocusVisualStyle="{x:Null}" ToolTip="{Binding Tooltip}" Click="OnAppIconClick" MouseRightButtonUp="OnAppIconRightClick" PreviewMouseLeftButtonDown="OnTrayIconPreviewMouseDown" PreviewMouseLeftButtonUp="OnTrayIconPreviewMouseUp" PreviewMouseMove="OnTrayIconPreviewMouseMove" LostMouseCapture="OnTrayIconLostCapture" MouseDown="OnTrayIconMouseDown" MouseUp="OnTrayIconMouseUp" PreviewKeyDown="OnTrayIconKeyDown" DragOver="OnTrayDragOver" Drop="OnTrayIconDrop">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Name="Bd" Background="#00FFFFFF" Padding="0" MinWidth="{DynamicResource TB.TraySlotWidth}" MinHeight="{DynamicResource TB.TraySlotWidth}">
                  <Grid>
                    <Image Name="IconImg" Width="{DynamicResource TB.TrayAppIconSize}" Height="{DynamicResource TB.TrayAppIconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                      <Image.Source>
                        <MultiBinding Converter="{StaticResource RestIconEdge}">
                          <Binding Path="Image" />
                          <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                      </Image.Source>
                    </Image>
                    <ContentPresenter Name="HostHolder" Content="{Binding HostElement}" Visibility="Collapsed" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Name="HintL" Width="2" Margin="0,3" HorizontalAlignment="Left" Background="{DynamicResource MenuAccent}" Visibility="Collapsed" />
                <Border Name="HintR" Width="2" Margin="0,3" HorizontalAlignment="Right" Background="{DynamicResource MenuAccent}" Visibility="Collapsed" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#22FFFFFF" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding HasHost}">
                  <Setter TargetName="IconImg" Property="UIElement.Visibility" Value="Collapsed" />
                  <Setter TargetName="HostHolder" Property="UIElement.Visibility" Value="Visible" />
                  <Setter TargetName="Bd" Property="Border.Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Value="1" Binding="{Binding DropHint}">
                  <Setter TargetName="HintL" Property="UIElement.Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="2" Binding="{Binding DropHint}">
                  <Setter TargetName="HintR" Property="UIElement.Visibility" Value="Visible" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="PinnedButtonTemplate" DataType="{x:Type local:PinItem}">
        <Button Cursor="Hand" Width="48" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Click="OnPinnedClick" MouseRightButtonUp="OnPinnedRightClick" PreviewMouseLeftButtonDown="OnPinnedDragStart" PreviewMouseMove="OnPinnedDragMove" PreviewMouseLeftButtonUp="OnPinnedDragEnd" MouseEnter="OnTaskbarBtnEnter" MouseLeave="OnTaskbarBtnLeave">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="#00FFFFFF" Height="{DynamicResource TB.BarHeight}">
                <Grid>
                  <Image Width="{DynamicResource TB.IconSize}" Height="{DynamicResource TB.IconSize}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                    <Image.Source>
                      <MultiBinding Converter="{StaticResource RestIconEdge}">
                        <Binding Path="Icon" />
                        <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                  <StackPanel Name="Ind" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed">
                    <Border Name="Seg1" Height="3" Width="22" Background="{DynamicResource TB.AccentDim}" />
                    <Border Name="Seg2" Height="3" Width="0" Background="{DynamicResource TB.AccentDim}" />
                  </StackPanel>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsRunning}">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnRunning}" />
                  <Setter TargetName="Ind" Property="UIElement.Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnHover}" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding MultiInstance}">
                  <Setter TargetName="Seg1" Property="FrameworkElement.Width" Value="10" />
                  <Setter TargetName="Seg2" Property="FrameworkElement.Width" Value="10" />
                  <Setter TargetName="Seg2" Property="FrameworkElement.Margin" Value="3,0,0,0" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsForeground}">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnActive}" />
                  <Setter TargetName="Seg1" Value="{DynamicResource TB.Accent}" Property="Border.Background" />
                  <Setter TargetName="Seg2" Value="{DynamicResource TB.Accent}" Property="Border.Background" />
                </DataTrigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnPressed}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="TaskButtonTemplate" DataType="{x:Type local:TaskWindow}">
        <Button Cursor="Hand" MaxWidth="200" FocusVisualStyle="{x:Null}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" Click="OnTaskClick" MouseRightButtonUp="OnTaskRightClick" MouseEnter="OnTaskbarBtnEnter" MouseLeave="OnTaskbarBtnLeave">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{DynamicResource TB.BtnRunning}" Height="{DynamicResource TB.BarHeight}">
                <Grid>
                  <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <Image Width="{DynamicResource TB.IconSize}" Height="{DynamicResource TB.IconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                      <Image.Source>
                        <MultiBinding Converter="{StaticResource RestIconEdge}">
                          <Binding Path="Icon" />
                          <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                      </Image.Source>
                    </Image>
                    <TextBlock Foreground="{DynamicResource TB.GlyphInk}" FontFamily="Segoe UI" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Visibility="{Binding ShowLabel, Converter={StaticResource B2V}}" />
                  </StackPanel>
                  <Border Name="Ul" Height="3" Background="{DynamicResource TB.AccentDim}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6,0,6,2" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnHover}" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsForeground}">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnActive}" />
                  <Setter TargetName="Ul" Value="{DynamicResource TB.Accent}" Property="Border.Background" />
                </DataTrigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.BtnPressed}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
      <Style x:Key="{x:Type CalendarDayButton}" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="#EEFFFFFF" />
      </Style>
      <Style x:Key="{x:Type CalendarButton}" TargetType="{x:Type CalendarButton}">
        <Setter Property="Foreground" Value="#EEFFFFFF" />
      </Style>
      <Style x:Key="DeviceRow" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Background" Value="#FF0A4D83" />
        <Setter Property="BorderBrush" Value="#24FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="0.91" Property="UIElement.Opacity" />
                  <Setter TargetName="Bd" Value="#55FFFFFF" Property="Border.BorderBrush" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Value="0.78" Property="UIElement.Opacity" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroSoundActionTile" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
        <Setter Property="Background" Value="#FF078FEF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Name="TileSurface" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="#22FFFFFF" BorderThickness="1" />
                <Border Name="HoverLayer" Background="#20FFFFFF" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="#66FFFFFF" />
                  <Setter TargetName="HoverLayer" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="TileSurface" Property="UIElement.Opacity" Value="0.82" />
                  <Setter TargetName="TileSurface" Property="UIElement.RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX="0.975" ScaleY="0.975" /></Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- at most 26 DIP; in the compact footers it shrinks so the label row (Auto) is never clipped -->
      <Style x:Key="MetroSoundActionIcon" TargetType="{x:Type Viewbox}">
        <Setter Property="MaxWidth" Value="26" />
        <Setter Property="MaxHeight" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <!-- the shared stroke chevron (MenuGlyphs.Chevron, 6x10, 1.5 stroke, round caps), as in the menus -->
      <Style x:Key="MetroSoundActionChevron" TargetType="{x:Type Path}">
        <Setter Property="Data" Value="{x:Static local:MenuGlyphs.Chevron}" />
        <Setter Property="Stroke" Value="{DynamicResource TB.ChevronInk}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
      <Style x:Key="MetroSoundFooterLink" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.SoundLink}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" Padding="8,5">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#20FFFFFF" />
                  <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#38FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroTrayCommandButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
        <Setter Property="Background" Value="#14000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Name="CommandSurface" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <Border Name="HoverLayer" Background="#00FFFFFF" />
                <Border BorderBrush="#2EFFFFFF" BorderThickness="0,0,0,1" />
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="HoverLayer" Property="Border.Background" Value="#24FFFFFF" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="CommandSurface" Property="UIElement.Opacity" Value="0.76" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetroTrayCommandIcon" TargetType="{x:Type Viewbox}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <Style x:Key="FlyoutLink" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TaskbarLink}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="#00FFFFFF" Padding="6,3" CornerRadius="2">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Value="{DynamicResource TaskbarHover}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- The clock and volume flyouts' rows and buttons (device rows, expanders, app icons, the footer link and its icon
           buttons): no fill of their own; hover and keyboard focus take TB.FlyoutHover, a press TB.FlyoutPressed. The Action
           Center's footer button, ported. -->
      <Style x:Key="FlyoutRow" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.Ink}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.FlyoutHover}" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.FlyoutHover}" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.FlyoutPressed}" />
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- The 40 DIP footer link (the gear centred on the 32 DIP icon column: 1 frame + 19 padding, the label at x = 52). -->
      <Style x:Key="FlyoutFooterButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FlyoutRow}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="19,0,8,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <!-- A 40 x 40 footer icon button with a 16 DIP vector (the Action Center's Power button). -->
      <Style x:Key="FlyoutIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FlyoutRow}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <!-- A 16 DIP line glyph on the 24-unit grid (devices, expanders, footer icons). -->
      <Style x:Key="FlyoutGlyph16" TargetType="{x:Type Viewbox}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>
      <Style x:Key="FlyoutStroke" TargetType="{x:Type Path}">
        <Setter Property="Stroke" Value="{DynamicResource TB.Ink}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
      </Style>
      <!-- The flyouts' disclosure chevron (MenuGlyphs.ChevronDown, 10 x 6, 1.5 stroke) in a 24 DIP column; it turns 180 degrees. -->
      <Style x:Key="FlyoutChevron" TargetType="{x:Type Path}">
        <Setter Property="Data" Value="{x:Static local:MenuGlyphs.ChevronDown}" />
        <Setter Property="Stroke" Value="{DynamicResource TB.ChevronInk}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>
      <!-- A calendar day: the cell less 2 DIP on each side (4 DIP gutters, the tile gutters), 12 px, a constant 1 DIP edge that
           only today (when it is not the selected day) colours, and the flyouts' hover / focus / pressed washes over the fill. -->
      <Style x:Key="MetroCalendarDay" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TB.DayInk}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid SnapsToDevicePixels="True">
                <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True" />
                <Border Name="Wash" Background="#00FFFFFF" SnapsToDevicePixels="True" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Wash" Property="Border.Background" Value="{DynamicResource TB.FlyoutHover}" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Wash" Property="Border.Background" Value="{DynamicResource TB.FlyoutHover}" />
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="Wash" Property="Border.Background" Value="{DynamicResource TB.FlyoutPressed}" />
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- The flyouts' slider (the Action Center's: an 8 DIP track, the fill up to a 10 x 24 thumb). The whole row it is
           stretched over is hit-testable (a transparent template root); arrows step 1, PageUp / PageDown 10. -->
      <Style x:Key="MetroSlider" TargetType="{x:Type Slider}">
        <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid Name="SliderRoot" Background="#00FFFFFF" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                <!-- Unfilled track: was #59FFFFFF (35% white) which read as a faint line on the dark flyout; raised to
                     ~60% white and 3px so the bar is clearly visible in every state (shared by the main + per-app sliders). -->
                <Border Height="8" Background="{DynamicResource TB.SliderTrack}" VerticalAlignment="Center" />
                <Border Height="8" BorderBrush="{DynamicResource TB.SliderTrackBorder}" BorderThickness="1" VerticalAlignment="Center" />
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" OverridesDefaultStyle="True">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Height="8" Background="{DynamicResource TB.Accent}" VerticalAlignment="Center" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" OverridesDefaultStyle="True">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Focusable="False" OverridesDefaultStyle="True">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Rectangle Width="10" Height="24" Fill="{DynamicResource TB.Ink}" />
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- keyboard focus: the flyouts' focus wash over the slider's band -->
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="SliderRoot" Property="Panel.Background" Value="{DynamicResource TB.FlyoutHover}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TrayGlyph" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TB.GlyphInk}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="{DynamicResource TB.GlyphSize}" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="#00FFFFFF" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.GlyphHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.GlyphPressed}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Tray status buttons (overflow chevron, network, volume, battery, Action Center): ONE slot shared with the app
           icons (TB.TraySlotWidth = 1.5 x the native tray frame, set per bar by ApplyTrayIconMetrics). No padding: the 1:1
           tray canvas or glyph is centred over the full bar height, so every icon shares the bar's centre line. -->
      <Style x:Key="TrayIcon" TargetType="{x:Type Button}" BasedOn="{StaticResource TrayGlyph}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="{DynamicResource TB.TraySlotWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource TB.TraySlotWidth}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="RootLayout" Background="#00FFFFFF" AllowDrop="True" DragOver="OnPinDragOver" Drop="OnPinFileDrop">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Name="LeftCluster" Grid.Column="2" Orientation="Horizontal">
      <Button Name="StartButton" Width="48" Height="{DynamicResource TB.BarHeight}" Cursor="Hand" ToolTip="Start" FocusVisualStyle="{x:Null}" Click="OnStartClick" MouseEnter="OnStartBtnEnter" MouseLeave="OnStartBtnLeave" PreviewMouseLeftButtonDown="OnStartBtnDown" PreviewMouseLeftButtonUp="OnStartBtnUp">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="Bd" Background="{DynamicResource TB.StartSurface}" BorderBrush="{DynamicResource TB.StartFrame}" BorderThickness="1,0" SnapsToDevicePixels="True">
              <Grid>
                <Ellipse Name="StartOrb" Width="40" Height="40" Visibility="Collapsed" SnapsToDevicePixels="True" StrokeThickness="1">
                  <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.26" Center="0.5,0.42" RadiusX="0.78" RadiusY="0.9">
                      <GradientStop Color="#F2FAFF" Offset="0" />
                      <GradientStop Color="#6FB8EC" Offset="0.42" />
                      <GradientStop Color="#2073C1" Offset="0.72" />
                      <GradientStop Color="#0A3A6E" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                  <Ellipse.Stroke>
                    <SolidColorBrush Color="#803A6EA0" />
                  </Ellipse.Stroke>
                </Ellipse>
                <Rectangle Name="StartGlyph" Width="{DynamicResource TB.StartGlyphSize}" Height="{DynamicResource TB.StartGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                  <UIElement.OpacityMask>
                    <ImageBrush x:Name="StartGlyphMask" Stretch="Uniform" />
                  </UIElement.OpacityMask>
                </Rectangle>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.StartSurfaceHover}" />
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.StartSurfacePressed}" />
                <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{DynamicResource TB.StartFramePressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
      </Button>
      <Button Name="SearchBtn" Style="{StaticResource TrayGlyph}" Content="" ToolTip="Search" Width="44" Click="OnSearchClick" />
      <Button Name="TaskViewBtn" Style="{StaticResource TrayGlyph}" Content="" ToolTip="Task view" Width="44" Click="OnTaskViewClick" />
    </StackPanel>
    <ItemsControl Name="PinnedHost" Grid.Column="3" ClipToBounds="True" ItemTemplate="{StaticResource PinnedButtonTemplate}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <local:AnimatedBar />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
    <Grid Name="TaskArea" Grid.Column="4" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ItemsControl Name="TaskHost" Grid.Column="0" ClipToBounds="True" PreviewMouseWheel="OnTaskStripWheel" ItemTemplate="{StaticResource TaskButtonTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <local:ShrinkStrip />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <Button Name="TaskOverflowButton" Grid.Column="1" Width="40" Style="{StaticResource TrayGlyph}" Content="&#xE70D;" ToolTip="More open apps" Visibility="Collapsed" Click="OnTaskOverflow" />
      <Popup Name="TaskOverflowPopup" StaysOpen="True" AllowsTransparency="True" Placement="Top" PopupAnimation="None" PlacementTarget="{Binding ElementName=TaskOverflowButton}" Opened="OnBarPopupOpened">
        <Border Background="{DynamicResource TB.FlyoutBg}" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="0" Padding="6" MinWidth="188" MaxWidth="268" UseLayoutRounding="True">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="464">
            <StackPanel>
              <StackPanel Name="PinOverflowSection" Visibility="Collapsed">
                <TextBlock Name="PinOverflowCaption" Text="PINNED" Foreground="#B3FFFFFF" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Margin="6,2,6,4" />
                <ItemsControl Name="PinOverflowHost" ItemTemplate="{StaticResource PinnedButtonTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
              <StackPanel Name="TaskOverflowSection" Visibility="Collapsed">
                <TextBlock Name="TaskOverflowCaption" Text="OPEN APPS" Foreground="#B3FFFFFF" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Margin="6,8,6,4" />
                <ItemsControl Name="TaskOverflowHost" ItemTemplate="{StaticResource TaskButtonTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <StackPanel Name="TrayRoot" Grid.Column="6" Orientation="Horizontal" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <!-- Classic taskbar "Toolbars": Address box + one shortcuts button per enabled folder, sitting next to the tray. -->
      <TextBox Name="AddressBox" Width="160" Margin="4,4,8,4" VerticalAlignment="Center" VerticalContentAlignment="Center"
               Visibility="Collapsed" Background="#22FFFFFF" Foreground="{DynamicResource TB.Ink}" CaretBrush="{DynamicResource TB.Ink}"
               BorderBrush="{DynamicResource TB.AddressBorder}" BorderThickness="2" Padding="5,1" FontFamily="Segoe UI" FontSize="12"
               ToolTip="Type a path, app name, or URL and press Enter" KeyUp="OnAddressBoxKeyUp" />
      <ItemsControl Name="ToolbarHost" VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Tag="{Binding Path}" Click="OnToolbarClick" MouseRightButtonUp="OnToolbarRightClick"
                    Cursor="Hand" ToolTip="{Binding Path}" VerticalAlignment="Stretch">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Name="bd" Background="Transparent" Padding="8,0" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="&#187;" Foreground="{DynamicResource TB.InkSoft}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Name="TrayPanel" Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0" Visibility="{Binding PerfVisible, Converter={StaticResource B2V}}">
          <TextBlock Foreground="#DDFFFFFF" FontFamily="Segoe UI" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding CpuText}" />
          <TextBlock Foreground="#DDFFFFFF" FontFamily="Segoe UI" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding RamText}" />
          <TextBlock Foreground="#AAFFFFFF" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Text="{Binding NetText}" />
        </StackPanel>
        <Button Name="OverflowChevron" Style="{StaticResource TrayIcon}" Content="" ToolTip="Show hidden icons (drop an icon here to hide it)" Visibility="Collapsed" AllowDrop="True" Click="OnOverflowChevron" DragOver="OnTrayDragOver" Drop="OnTrayHideDrop" />
        <Popup Name="OverflowPopup" StaysOpen="True" AllowsTransparency="True" Placement="Top" PopupAnimation="None" PlacementTarget="{Binding ElementName=OverflowChevron}" Opened="OnBarPopupOpened">
          <Border Background="{DynamicResource TB.FlyoutBg}" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="0" Padding="4,4" UseLayoutRounding="True">
            <ItemsControl Name="OverflowHost" ItemTemplate="{StaticResource TrayIconTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" MaxWidth="220" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Border>
        </Popup>
        <ItemsControl Name="TrayAppHost" VerticalAlignment="Stretch" ItemTemplate="{StaticResource TrayIconTemplate}" AllowDrop="True" Background="#00FFFFFF" DragOver="OnTrayDragOver" Drop="OnTrayStripDrop">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Button Name="NetButton" Style="{StaticResource TrayIcon}" ToolTip="{Binding NetTip}" Click="OnNetworkClick" MouseRightButtonUp="OnNetworkRightClick">
          <Image Width="{DynamicResource TB.Win81TrayIconSize}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding NetImage}" Opacity="{DynamicResource TB.SystemGlyphOpacity}" />
        </Button>
        <Popup Name="NetPopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" PlacementTarget="{Binding ElementName=NetButton}" Opened="OnNetworkPopupOpened" Closed="OnNetworkPopupClosed">
          <Border Name="NetworkFlyoutRoot" Width="376" Height="444" Background="#00000000" BorderBrush="{DynamicResource TB.NetworkBorder}" BorderThickness="1" CornerRadius="0" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
            <Border.RenderTransform>
              <TranslateTransform x:Name="NetworkFlyoutSlide" />
            </Border.RenderTransform>
            <Grid Background="{DynamicResource TB.NetworkBackground}">
              <Grid.RowDefinitions>
                <RowDefinition x:Name="NetworkHeaderRow" Height="100" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="NetworkFooterRow" Height="106" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource TB.NetworkHeader}" BorderBrush="#2AFFFFFF" BorderThickness="0,0,0,1" Padding="14,9,14,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Image Name="NetHeroImage" Grid.Column="0" Width="56" Height="52" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="NetTitle" Text="Network" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI Light" FontSize="26" TextTrimming="CharacterEllipsis" />
