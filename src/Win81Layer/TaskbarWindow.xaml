                    <Button Name="NetworkConnectionsButton" Grid.Column="1" Style="{StaticResource MetroSoundActionTile}" Background="{DynamicResource TB.NetworkConnectionsTile}" Margin="0,0,4,0" Click="OnOpenNetworkConnections" ToolTip="Network connections">
                      <Grid Margin="6,5,6,5"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" MinHeight="30" /></Grid.RowDefinitions><Viewbox Grid.Row="0" Style="{StaticResource MetroSoundActionIcon}"><Canvas Width="32" Height="32"><Path Data="M 2,4 L 22,4 L 22,19 L 2,19 Z M 9,19 L 9,25 M 5,25 L 15,25 M 19,18 L 30,18 L 30,28 L 19,28 Z" Fill="Transparent" Stroke="{DynamicResource TB.Ink}" StrokeThickness="2.2" StrokeLineJoin="Miter" /></Canvas></Viewbox><TextBlock Grid.Row="1" Text="Network&#x0a;connections" FontFamily="Segoe UI" FontSize="12" LineHeight="15" VerticalAlignment="Bottom" Margin="0,0,10,0" /><Path Grid.Row="1" Style="{StaticResource MetroSoundActionChevron}" Margin="0,0,0,3" /></Grid>
                    </Button>
                    <Button Name="NetworkTroubleshootButton" Grid.Column="2" Style="{StaticResource MetroSoundActionTile}" Background="{DynamicResource TB.NetworkTroubleshootTile}" Click="OnTroubleshootNetwork" ToolTip="Troubleshoot network problems">
                      <Grid Margin="6,5,6,5"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" MinHeight="30" /></Grid.RowDefinitions><Viewbox Grid.Row="0" Style="{StaticResource MetroSoundActionIcon}"><Canvas Width="32" Height="32"><Path Data="M 20,3 C 16,3 13,6 13,10 C 13,11.5 13.4,12.8 14.2,14 L 4,24.2 C 2.7,25.5 2.7,27.5 4,28.8 C 5.3,30.1 7.3,30.1 8.6,28.8 L 18.8,18.6 C 20,19.4 21.4,19.8 22.8,19.8 C 27,19.8 30,16.5 30,12.5 C 30,11.2 29.7,10 29.1,8.9 L 24.7,13.3 L 20.1,12.1 L 18.9,7.5 L 23.3,3.1 C 22.2,3 21.1,3 20,3 Z" Fill="{DynamicResource TB.Ink}" /></Canvas></Viewbox><TextBlock Grid.Row="1" Text="Troubleshoot&#x0a;problems" FontFamily="Segoe UI" FontSize="12" LineHeight="15" VerticalAlignment="Bottom" Margin="0,0,10,0" /><Path Grid.Row="1" Style="{StaticResource MetroSoundActionChevron}" Margin="0,0,0,3" /></Grid>
                    </Button>
                  </Grid>
                  <Button Grid.Row="1" Foreground="{DynamicResource TB.NetworkLink}" Style="{StaticResource MetroSoundFooterLink}" Click="OnOpenNetworkSharingCenter" ToolTip="Open Network and Sharing Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Open Network and Sharing Center" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="  →" FontFamily="Segoe UI Symbol" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Popup>
        <Popup Name="NetworkCommandPopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" PlacementTarget="{Binding ElementName=NetButton}" Opened="OnNetworkCommandPopupOpened" Closed="OnTrayCommandPopupClosed">
          <Border Name="NetworkCommandRoot" Width="290" Background="{DynamicResource TB.NetworkBackground}" BorderBrush="{DynamicResource TB.NetworkBorder}" BorderThickness="1" CornerRadius="0" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
            <Border.RenderTransform><TranslateTransform x:Name="NetworkCommandSlide" /></Border.RenderTransform>
            <StackPanel Name="NetworkCommandList">
              <!-- the default command: a neutral row with a SemiBold label (an accent fill read as a stuck hover) -->
              <Button Name="NetworkCommandSharingCenter" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenNetworkSharingCenter" ToolTip="Open Network and Sharing Center">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Ellipse Canvas.Left="3" Canvas.Top="3" Width="26" Height="26" Stroke="{DynamicResource TB.Ink}" StrokeThickness="2.2" /><Path Data="M 16,3 C 10,8 10,24 16,29 M 16,3 C 22,8 22,24 16,29 M 3,16 L 29,16 M 6,9 L 26,9 M 6,23 L 26,23" Stroke="{DynamicResource TB.Ink}" StrokeThickness="1.8" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Network and Sharing Center" FontWeight="SemiBold" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Name="NetworkCommandConnections" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenNetworkConnections" ToolTip="Network connections">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="M 2,4 L 22,4 L 22,19 L 2,19 Z M 9,19 L 9,25 M 5,25 L 15,25 M 19,18 L 30,18 L 30,28 L 19,28 Z" Fill="Transparent" Stroke="{DynamicResource TB.Ink}" StrokeThickness="2.2" StrokeLineJoin="Miter" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Network connections" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Name="NetworkCommandTroubleshoot" Style="{StaticResource MetroTrayCommandButton}" Click="OnTroubleshootNetwork" ToolTip="Troubleshoot network problems">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="M 20,3 C 16,3 13,6 13,10 C 13,11.5 13.4,12.8 14.2,14 L 4,24.2 C 2.7,25.5 2.7,27.5 4,28.8 C 5.3,30.1 7.3,30.1 8.6,28.8 L 18.8,18.6 C 20,19.4 21.4,19.8 22.8,19.8 C 27,19.8 30,16.5 30,12.5 C 30,11.2 29.7,10 29.1,8.9 L 24.7,13.3 L 20.1,12.1 L 18.9,7.5 L 23.3,3.1 C 22.2,3 21.1,3 20,3 Z" Fill="{DynamicResource TB.Ink}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Troubleshoot problems" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Name="NetworkCommandSettings" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenNetworkSettings" ToolTip="Network and Internet settings">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="F0 M 13,1 L 19,1 L 19.8,5.1 L 22.1,6 L 25.6,3.6 L 29.4,7.4 L 27,10.9 L 27.9,13.2 L 31,14 L 31,18 L 27.9,18.8 L 27,21.1 L 29.4,24.6 L 25.6,28.4 L 22.1,26 L 19.8,26.9 L 19,31 L 13,31 L 12.2,26.9 L 9.9,26 L 6.4,28.4 L 2.6,24.6 L 5,21.1 L 4.1,18.8 L 1,18 L 1,14 L 4.1,13.2 L 5,10.9 L 2.6,7.4 L 6.4,3.6 L 9.9,6 L 12.2,5.1 Z M 16,11 A 5,5 0 1 0 16,21 A 5,5 0 1 0 16,11 Z" Fill="{DynamicResource TB.Ink}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Network settings" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </Popup>
        <Button Name="VolumeButton" Style="{StaticResource TrayIcon}" ToolTip="{Binding VolumeTip}" Click="OnVolumeClick" MouseWheel="OnVolumeWheel" MouseRightButtonUp="OnVolumeRightClick">
          <Grid>
            <Image Name="VolumeIcon81" Width="{DynamicResource TB.Win81TrayIconSize}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="{Binding TrayVolumeImage}" Opacity="{DynamicResource TB.SystemGlyphOpacity}" Visibility="{Binding VolumeImageVis}" />
            <TextBlock Name="VolumeGlyphText" Text="{Binding VolumeGlyph}" Visibility="{Binding VolumeGlyphVis}" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource TB.GlyphSize}" Foreground="{DynamicResource TB.GlyphInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Name="BatteryButton" Style="{StaticResource TrayIcon}" Content="{Binding BatteryGlyph}" ToolTip="{Binding BatteryTip}" Visibility="{Binding BatteryVisible, Converter={StaticResource B2V}}" Click="OnBatteryClick" MouseRightButtonUp="OnBatteryRightClick" />
        <Popup Name="VolumePopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" PlacementTarget="{Binding ElementName=VolumeButton}" Opened="OnVolumePopupOpened" Closed="OnVolumePopupClosed">
          <!-- The volume flyout: a compact quick-settings panel in the Action Center family, 376 DIP wide and as tall as its
               content (the master row, the output devices, the input device and the app volumes behind two disclosure rows,
               the footer). The frame and body appear at once; only VolumeContent moves and fades. -->
          <Border Name="VolumeFlyoutRoot" Width="376" Background="{DynamicResource TB.SoundBackground}" BorderBrush="{DynamicResource TB.SoundBorder}" BorderThickness="1" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" PreviewKeyDown="OnVolumeFlyoutKeyDown">
            <Grid ClipToBounds="True">
              <Grid Name="VolumeContent">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="VolumeFlyoutSlide" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- the master row: the Action Center's volume row (32 icon | 8 | slider | 44 value) -->
                <Grid Name="VolumeMasterRow" Grid.Row="0" Margin="11,6,11,0" Height="40">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                  </Grid.ColumnDefinitions>
                  <Button Name="MuteToggle" Grid.Column="0" Style="{StaticResource FlyoutRow}" Width="32" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnMuteToggle" ToolTip="Mute or unmute" AutomationProperties.Name="Mute or unmute">
                    <Border Name="MuteToggleGlyph" Width="20" Height="20" IsHitTestVisible="False" />
                  </Button>
                  <Slider Name="VolumeSlider" Grid.Column="2" Minimum="0" Maximum="100" Style="{StaticResource MetroSlider}" VerticalAlignment="Stretch" Value="{Binding VolumePct, Mode=TwoWay}" ValueChanged="OnVolumeSliderChanged" AutomationProperties.Name="Volume" />
                  <TextBlock Name="VolumePercent" Grid.Column="3" Foreground="{DynamicResource TB.FlyoutValueInk}" FontFamily="Segoe UI" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,1" IsHitTestVisible="False" />
                </Grid>
                <ScrollViewer Name="VolumeBodyScroll" Grid.Row="1" ScrollChanged="OnFlyoutBodyScrollChanged" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" IsManipulationEnabled="True" Focusable="False" PanningMode="VerticalOnly" PanningDeceleration="0.0025" PanningRatio="1.0">
                  <ScrollViewer.Resources>
                    <!-- the Action Center's slim 10 DIP bar, over the rows' right padding (only while the body is clamped) -->
                    <Style TargetType="{x:Type ScrollBar}">
                      <Setter Property="Width" Value="10" />
                      <Setter Property="MinWidth" Value="10" />
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Width="10" Background="#00FFFFFF" SnapsToDevicePixels="True">
                              <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                  <Thumb MinHeight="24" Focusable="False" Cursor="Hand">
                                    <Thumb.Template>
                                      <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Grid Background="#00FFFFFF">
                                          <Border Name="ThumbVisual" Width="4" Margin="0,1" Background="{DynamicResource Metro81.ScrollThumbBrushDark}" HorizontalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbVisual" Property="Border.Background" Value="{DynamicResource Metro81.ScrollThumbHoverBrushDark}" />
                                          </Trigger>
                                          <Trigger Property="Thumb.IsDragging" Value="True">
                                            <Setter TargetName="ThumbVisual" Property="Border.Background" Value="{DynamicResource Metro81.ScrollThumbPressedBrushDark}" />
                                          </Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </Thumb.Template>
                                  </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                              </Track>
                            </Grid>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ScrollViewer.Resources>
                  <!-- the bar lies over the content (the rows keep their full width; the bar sits in their 11 DIP right padding) -->
                  <ScrollViewer.Template>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                      <Grid Background="{TemplateBinding Control.Background}">
                        <ScrollContentPresenter Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" Margin="{TemplateBinding Control.Padding}" />
                        <ScrollBar Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical" Cursor="Arrow" Minimum="0" Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}" ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}" Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}" />
                      </Grid>
                    </ControlTemplate>
                  </ScrollViewer.Template>
                  <StackPanel Name="VolumeBodyPanel">
                    <!-- output devices: one full-bleed 32 DIP row each, the default one ticked -->
                    <StackPanel Name="OutputList" Margin="0,4,0,0" KeyboardNavigation.DirectionalNavigation="Contained" />
                    <!-- the input device: the default one on a disclosure row; the others behind it (code orders the list on the side
                         away from the taskbar, so the row never moves under the pointer) -->
                    <StackPanel Name="InputGroup" Margin="0,4,0,0">
                      <Button Name="InputExpander" Style="{StaticResource FlyoutRow}" Height="32" Padding="11,0,11,0" Click="OnInputExpanderClick" AutomationProperties.Name="Input device">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>
                          <Viewbox Grid.Column="0" Style="{StaticResource FlyoutGlyph16}">
                            <Canvas Width="24" Height="24">
                              <Path Style="{StaticResource FlyoutStroke}" Data="M12,3 C10.3,3 9,4.3 9,6 L9,12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 L15,6 C15,4.3 13.7,3 12,3 Z M6,11 C6,14.3 8.7,17 12,17 C15.3,17 18,14.3 18,11 M12,17 L12,21 M8.5,21 L15.5,21" />
                            </Canvas>
                          </Viewbox>
                          <TextBlock Name="InputExpanderName" Grid.Column="2" Text="No input device" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1" />
                          <Path Name="InputChevron" Grid.Column="3" Style="{StaticResource FlyoutChevron}">
                            <Path.RenderTransform>
                              <RotateTransform x:Name="InputChevronTurn" />
                            </Path.RenderTransform>
                          </Path>
                        </Grid>
                      </Button>
                      <StackPanel Name="InputList" Visibility="Collapsed" KeyboardNavigation.DirectionalNavigation="Contained" />
                    </StackPanel>
                    <!-- app volume: a disclosure row with the session count; the 48 DIP app rows behind it -->
                    <StackPanel Name="AppsGroup">
                      <Button Name="AppsExpander" Style="{StaticResource FlyoutRow}" Height="32" Padding="11,0,11,0" Click="OnAppsExpanderClick" AutomationProperties.Name="App volume">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>
                          <Viewbox Grid.Column="0" Style="{StaticResource FlyoutGlyph16}">
                            <Canvas Width="24" Height="24">
                              <Path Style="{StaticResource FlyoutStroke}" Data="M6,3 L6,21 M12,3 L12,21 M18,3 L18,21 M4,14 L8,14 M10,7 L14,7 M16,11 L20,11" />
                            </Canvas>
                          </Viewbox>
                          <TextBlock Grid.Column="2" Text="App volume" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1" />
                          <TextBlock Name="AppsCount" Grid.Column="3" Text="None" Foreground="{DynamicResource TB.FlyoutSecondaryInk}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,1" />
                          <Path Name="AppsChevron" Grid.Column="4" Style="{StaticResource FlyoutChevron}">
                            <Path.RenderTransform>
                              <RotateTransform x:Name="AppsChevronTurn" />
                            </Path.RenderTransform>
                          </Path>
                        </Grid>
                      </Button>
                      <ItemsControl Name="AppVolumeHost" Focusable="False" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <!-- one app: [32 icon (mute) | 8 | name over its slider | 44 value], 48 DIP -->
                            <Grid Height="48" Margin="11,0,11,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="4" />
                              </Grid.RowDefinitions>
                              <Button Grid.Column="0" Grid.RowSpan="4" Style="{StaticResource FlyoutRow}" Width="32" Height="48" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnAppMuteClick" ToolTip="{Binding MuteTip}" AutomationProperties.Name="{Binding MuteTip}">
                                <Grid x:Name="AppIconHost" Width="20" Height="20" IsHitTestVisible="False">
                                  <Viewbox x:Name="AppFallback" Width="20" Height="20" Stretch="Uniform" Visibility="Collapsed" SnapsToDevicePixels="True">
                                    <Canvas Width="24" Height="24">
                                      <Path Fill="{DynamicResource TB.Ink}" Data="M 2,9.2 L 6.2,9.2 L 11,4.8 L 11,19.2 L 6.2,14.8 L 2,14.8 Z" />
                                      <Path Style="{StaticResource FlyoutStroke}" Data="M 14,9.4 C 15.3,10.8 15.3,13.2 14,14.6 M 16.8,6.9 C 19.4,9.8 19.4,14.2 16.8,17.1" />
                                    </Canvas>
                                  </Viewbox>
                                  <Image x:Name="AppIcon" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" local:RestFlag.On="{DynamicResource TB.RestIcons}">
                                    <Image.Source>
                                      <MultiBinding Converter="{StaticResource RestIconEdge}">
                                        <Binding Path="Icon" />
                                        <Binding Path="(local:RestFlag.On)" RelativeSource="{RelativeSource Self}" />
                                      </MultiBinding>
                                    </Image.Source>
                                  </Image>
                                </Grid>
                              </Button>
                              <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Name}" Foreground="{DynamicResource TB.FlyoutValueInk}" FontFamily="Segoe UI" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                              <Slider Grid.Column="2" Grid.Row="2" Minimum="0" Maximum="100" Style="{StaticResource MetroSlider}" VerticalAlignment="Stretch" Value="{Binding VolumePct, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
                              <TextBlock x:Name="AppValue" Grid.Column="3" Grid.Row="2" Text="{Binding VolumePct}" Foreground="{DynamicResource TB.FlyoutValueInk}" FontFamily="Segoe UI" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,1" IsHitTestVisible="False" />
                            </Grid>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter TargetName="AppIcon" Property="UIElement.Visibility" Value="Collapsed" />
                                <Setter TargetName="AppFallback" Property="UIElement.Visibility" Value="Visible" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Muted}" Value="True">
                                <Setter TargetName="AppIconHost" Property="UIElement.Opacity" Value="0.45" />
                                <Setter TargetName="AppValue" Property="TextBlock.Text" Value="Muted" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
                <!-- more below: the last 16 DIP of a clamped body fade into the footer (shown only while it can scroll) -->
                <Rectangle Name="VolumeBodyFade" Grid.Row="1" Height="16" VerticalAlignment="Bottom" Margin="0,0,10,0" Fill="{DynamicResource TB.SoundFooter}" IsHitTestVisible="False" Visibility="Collapsed">
                  <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#00000000" Offset="0" />
                      <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                  </Rectangle.OpacityMask>
                </Rectangle>
                <!-- the footer: Sound settings on the left (an error takes its label), four 40 DIP icon routes on the right -->
                <Border Name="VolumeFooterBar" Grid.Row="2" Margin="0,6,0,0" Height="41" Background="{DynamicResource TB.SoundFooter}" BorderBrush="{DynamicResource TB.FlyoutDivider}" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Name="SoundSettingsLink" Grid.Column="0" Style="{StaticResource FlyoutFooterButton}" Click="OnOpenSoundSettings" ToolTip="Sound settings" AutomationProperties.Name="Sound settings">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Source="{DynamicResource TB.SoundGear}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" />
                        <TextBlock Name="SoundSettingsLabel" Grid.Column="1" Text="Sound settings" Foreground="{DynamicResource TB.SoundLink}" FontFamily="Segoe UI" FontSize="12" Margin="16,0,0,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                    <StackPanel Name="SoundActionGrid" Grid.Column="1" Orientation="Horizontal">
                      <Button Name="PlaybackDevicesButton" Style="{StaticResource FlyoutIconButton}" Click="OnOpenPlaybackDevices" ToolTip="Playback devices" AutomationProperties.Name="Playback devices">
                        <Viewbox Style="{StaticResource FlyoutGlyph16}">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource FlyoutStroke}" Data="M 6,3.5 L 19.5,12 L 6,20.5 Z" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Name="RecordingDevicesButton" Style="{StaticResource FlyoutIconButton}" Click="OnOpenRecordingDevices" ToolTip="Recording devices" AutomationProperties.Name="Recording devices">
                        <Viewbox Style="{StaticResource FlyoutGlyph16}">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource FlyoutStroke}" Data="M12,3 C10.3,3 9,4.3 9,6 L9,12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 L15,6 C15,4.3 13.7,3 12,3 Z M6,11 C6,14.3 8.7,17 12,17 C15.3,17 18,14.3 18,11 M12,17 L12,21 M8.5,21 L15.5,21" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Name="SoundsButton" Style="{StaticResource FlyoutIconButton}" Click="OnOpenSounds" ToolTip="Sounds" AutomationProperties.Name="Sounds">
                        <Viewbox Style="{StaticResource FlyoutGlyph16}">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource FlyoutStroke}" Data="M 9,17.6 L 9,5.6 L 20,3.4 L 20,15.6 M 9,9.2 L 20,7" />
                            <Ellipse Canvas.Left="3.4" Canvas.Top="15.4" Width="5.6" Height="4.4" Fill="{DynamicResource TB.Ink}" />
                            <Ellipse Canvas.Left="14.4" Canvas.Top="13.4" Width="5.6" Height="4.4" Fill="{DynamicResource TB.Ink}" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Name="ClassicMixerButton" Style="{StaticResource FlyoutIconButton}" Click="OnOpenClassicVolumeMixer" ToolTip="Open volume mixer in classic view" AutomationProperties.Name="Open volume mixer in classic view">
                        <Viewbox Style="{StaticResource FlyoutGlyph16}">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource FlyoutStroke}" Data="M6,3 L6,21 M12,3 L12,21 M18,3 L18,21 M4,14 L8,14 M10,7 L14,7 M16,11 L20,11" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Popup>
        <Popup Name="SoundCommandPopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" PlacementTarget="{Binding ElementName=VolumeButton}" Opened="OnSoundCommandPopupOpened" Closed="OnTrayCommandPopupClosed">
          <Border Name="SoundCommandRoot" Width="272" Background="{DynamicResource TB.SoundBackground}" BorderBrush="{DynamicResource TB.SoundBorder}" BorderThickness="1" CornerRadius="0" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
            <Border.RenderTransform><TranslateTransform x:Name="SoundCommandSlide" /></Border.RenderTransform>
            <StackPanel Name="SoundCommandList">
              <!-- the default command: a neutral row with a SemiBold label; the icons are the flyout tiles' icons -->
              <Button Name="SoundCommandMixer" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenClassicVolumeMixer" ToolTip="Open volume mixer">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="M 3,12 L 9,12 L 16,6 L 16,26 L 9,20 L 3,20 Z M 21,11 C 24,14 24,18 21,21 M 25,7 C 31,12 31,20 25,25" Fill="Transparent" Stroke="{DynamicResource TB.Ink}" StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Volume mixer" FontWeight="SemiBold" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Name="SoundCommandPlayback" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenPlaybackDevices" ToolTip="Playback devices">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="M 8,4 L 26,16 L 8,28 Z" Fill="Transparent" Stroke="{DynamicResource TB.Ink}" StrokeThickness="2.3" StrokeLineJoin="Miter" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Playback devices" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Name="SoundCommandRecording" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenRecordingDevices" ToolTip="Recording devices">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="M 16,3 C 12.9,3 11,5.3 11,8 L 11,16 C 11,19.1 13.1,21 16,21 C 18.9,21 21,19.1 21,16 L 21,8 C 21,5.3 19.1,3 16,3 Z M 7,15 C 7,21 10.8,25 16,25 C 21.2,25 25,21 25,15 M 16,25 L 16,29 M 11,29 L 21,29" Fill="Transparent" Stroke="{DynamicResource TB.Ink}" StrokeThickness="2.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Recording devices" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Name="SoundCommandSounds" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenSounds" ToolTip="Sounds">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="M 13,8 L 26,5 L 26,20 M 13,8 L 13,23 M 13,11 L 26,8" Fill="Transparent" Stroke="{DynamicResource TB.Ink}" StrokeThickness="2.3" StrokeStartLineCap="Square" StrokeEndLineCap="Square" StrokeLineJoin="Miter" /><Ellipse Canvas.Left="5" Canvas.Top="20" Width="9" Height="6" Fill="{DynamicResource TB.Ink}" /><Ellipse Canvas.Left="18" Canvas.Top="17" Width="9" Height="6" Fill="{DynamicResource TB.Ink}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Sounds" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
              <Button Name="SoundCommandSettings" Style="{StaticResource MetroTrayCommandButton}" Click="OnOpenSoundSettings" ToolTip="Sound settings">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Style="{StaticResource MetroTrayCommandIcon}"><Canvas Width="32" Height="32"><Path Data="F0 M 13,1 L 19,1 L 19.8,5.1 L 22.1,6 L 25.6,3.6 L 29.4,7.4 L 27,10.9 L 27.9,13.2 L 31,14 L 31,18 L 27.9,18.8 L 27,21.1 L 29.4,24.6 L 25.6,28.4 L 22.1,26 L 19.8,26.9 L 19,31 L 13,31 L 12.2,26.9 L 9.9,26 L 6.4,28.4 L 2.6,24.6 L 5,21.1 L 4.1,18.8 L 1,18 L 1,14 L 4.1,13.2 L 5,10.9 L 2.6,7.4 L 6.4,3.6 L 9.9,6 L 12.2,5.1 Z M 16,11 A 5,5 0 1 0 16,21 A 5,5 0 1 0 16,11 Z" Fill="{DynamicResource TB.Ink}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Sound settings" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
      <StackPanel Name="ClockPanel" VerticalAlignment="Center" Margin="12,0" MinWidth="70" Cursor="Hand" ToolTip="Date and time" MouseLeftButtonUp="OnClockClick" MouseRightButtonUp="OnClockRightClick">
        <TextBlock Name="ClockTime" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Right" />
        <TextBlock Name="ClockDate" Foreground="#CCFFFFFF" FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Right" />
      </StackPanel>
      <Popup Name="ClockPopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" PlacementTarget="{Binding ElementName=ClockPanel}" Opened="OnClockPopupOpened" Closed="OnClockPopupClosed">
        <!-- The clock and calendar: a compact quick-settings panel in the Action Center family, 376 x 357 DIP (the time and
             the date, the month and its navigation, six week rows, the settings footer). The frame and body appear at once;
             only ClockContent moves and fades. -->
        <Border Name="ClockFlyoutRoot" Width="376" Height="357" Background="{DynamicResource TB.ClockBackground}" BorderBrush="{DynamicResource TB.ClockBorder}" BorderThickness="1" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnClockFlyoutKeyDown">
          <Grid ClipToBounds="True">
            <Grid Name="ClockContent">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="ClockFlyoutSlide" />
              </Grid.RenderTransform>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <!-- the time (Light 32, the seconds Light 15 on the same baseline: equal 40 DIP block lines) and the date -->
              <StackPanel Name="ClockHeaderPanel" Grid.Row="0" Margin="11,12,11,0">
                <StackPanel Orientation="Horizontal" Height="40">
                  <TextBlock Name="ClockBig" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI Light" FontSize="32" FontWeight="Light" LineHeight="40" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top" />
                  <TextBlock Name="ClockSeconds" Foreground="{DynamicResource TB.FlyoutValueInk}" FontFamily="Segoe UI Light" FontSize="15" FontWeight="Light" LineHeight="40" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Top" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Name="ClockFull" Foreground="{DynamicResource TB.FlyoutValueInk}" FontFamily="Segoe UI" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <!-- the month (12 px SemiBold) and its 32 DIP arrows, the next one ending at x = 364 -->
              <Grid Name="CalendarNav" Grid.Row="1" Margin="11,8,11,0" Height="32">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="MonthLabel" Grid.Column="0" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,1">
                  <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="MonthLabelSlide" />
                  </TextBlock.RenderTransform>
                </TextBlock>
                <local:MetroDirectionalArrow81 x:Name="PrevMonth" Grid.Column="1" Width="32" Height="32" GlyphSize="20" Direction="Left" ToolTip="Previous month" AutomationProperties.Name="Previous month" Click="OnPrevMonth" />
                <local:MetroDirectionalArrow81 x:Name="NextMonth" Grid.Column="2" Width="32" Height="32" GlyphSize="20" Direction="Right" ToolTip="Next month" AutomationProperties.Name="Next month" Click="OnNextMonth" />
              </Grid>
              <!-- the weekdays (20 DIP) and six week rows; the day fills run from x = 12 to 364 with 4 DIP gutters -->
              <Grid Name="MonthGrid" Grid.Row="2" Margin="9,0,9,0" Height="200" ClipToBounds="True" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Once">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="MonthGridSlide" />
                </Grid.RenderTransform>
              </Grid>
              <!-- the footer: the Action Center's (1 DIP divider, 40 DIP row, the gear on the 32 DIP icon column, the label at x = 52) -->
              <Border Name="ClockFooterBar" Grid.Row="4" Height="41" Background="{DynamicResource TB.ClockFooter}" BorderBrush="{DynamicResource TB.FlyoutDivider}" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
                <Button Name="ClockSettingsLink" Style="{StaticResource FlyoutFooterButton}" ToolTip="Change date and time settings" AutomationProperties.Name="Change date and time settings" Click="OnOpenDateTimeSettings">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Name="ClockSettingsGear" Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Source="{DynamicResource TB.ClockGear}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" VerticalAlignment="Center" />
                    <TextBlock Name="ClockSettingsLabel" Grid.Column="1" Text="Date and time settings" Foreground="{DynamicResource TB.ClockLink}" FontFamily="Segoe UI" FontSize="12" Margin="16,0,0,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Button>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Popup>
      <Button Name="ActionCenterBtn" Style="{StaticResource TrayIcon}" ToolTip="Action center" Click="OnActionCenter">
        <Grid>
          <Image Name="NotifIcon81" Width="{DynamicResource TB.Win81TrayIconSize}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Source="pack://application:,,,/Assets/win81icons/notifications81.png" Opacity="{DynamicResource TB.SystemGlyphOpacity}" />
          <TextBlock Name="NotifGlyphNative" Visibility="Collapsed" Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource TB.GlyphSize}" Foreground="{DynamicResource TB.GlyphInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <Border Name="ShowDesktop" Width="8" Background="#11FFFFFF" Cursor="Hand" ToolTip="Show desktop" MouseLeftButtonUp="OnShowDesktop" MouseEnter="OnShowDesktopEnter" MouseLeave="OnShowDesktopLeave" />
    </StackPanel>
    <Border Grid.Column="0" Grid.ColumnSpan="7" VerticalAlignment="Top" Height="1" Background="{DynamicResource TB.BarEdge}" IsHitTestVisible="False" />
  </Grid>
</Window>
