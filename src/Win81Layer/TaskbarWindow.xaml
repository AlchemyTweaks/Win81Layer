        </Border>
      </Popup>
    </Grid>
    <StackPanel Name="TrayRoot" Grid.Column="6" Orientation="Horizontal" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <!-- Classic taskbar "Toolbars": Address box + one shortcuts button per enabled folder, sitting next to the tray. -->
