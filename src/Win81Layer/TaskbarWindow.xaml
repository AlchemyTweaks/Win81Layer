          <TextBlock Foreground="#DDFFFFFF" FontFamily="Segoe UI" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding CpuText}" />
          <TextBlock Foreground="#DDFFFFFF" FontFamily="Segoe UI" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding RamText}" />
          <TextBlock Foreground="#AAFFFFFF" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Text="{Binding NetText}" />
