    <StackPanel Name="LeftCluster" Grid.Column="2" Orientation="Horizontal">
      <Button Name="StartButton" Width="48" Height="{DynamicResource TB.BarHeight}" Cursor="Hand" ToolTip="Start" FocusVisualStyle="{x:Null}" Click="OnStartClick" MouseEnter="OnStartBtnEnter" MouseLeave="OnStartBtnLeave" PreviewMouseLeftButtonDown="OnStartBtnDown" PreviewMouseLeftButtonUp="OnStartBtnUp">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="Bd" Background="{DynamicResource TB.StartSurface}" BorderBrush="{DynamicResource TB.StartFrame}" BorderThickness="1,0" SnapsToDevicePixels="True">
              <Grid>
                <Ellipse Name="StartOrb" Width="40" Height="40" Visibility="Collapsed" SnapsToDevicePixels="True" StrokeThickness="1">
                  <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.26" Center="0.5,0.42" RadiusX="0.78" RadiusY="0.9">
                      <GradientStop Color="#F2FAFF" Offset="0" />
                      <GradientStop Color="#6FB8EC" Offset="0.42" />
                      <GradientStop Color="#2073C1" Offset="0.72" />
                      <GradientStop Color="#0A3A6E" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                  <Ellipse.Stroke>
                    <SolidColorBrush Color="#803A6EA0" />
                  </Ellipse.Stroke>
                </Ellipse>
                <Rectangle Name="StartGlyph" Width="{DynamicResource TB.StartGlyphSize}" Height="{DynamicResource TB.StartGlyphSize}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                  <UIElement.OpacityMask>
                    <ImageBrush x:Name="StartGlyphMask" Stretch="Uniform" />
                  </UIElement.OpacityMask>
                </Rectangle>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.StartSurfaceHover}" />
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource TB.StartSurfacePressed}" />
                <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{DynamicResource TB.StartFramePressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
      </Button>
      <Button Name="SearchBtn" Style="{StaticResource TrayGlyph}" Content="" ToolTip="Search" Width="44" Click="OnSearchClick" />
      <Button Name="TaskViewBtn" Style="{StaticResource TrayGlyph}" Content="" ToolTip="Task view" Width="44" Click="OnTaskViewClick" />
    </StackPanel>
    <ItemsControl Name="PinnedHost" Grid.Column="3" ClipToBounds="True" ItemTemplate="{StaticResource PinnedButtonTemplate}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <local:AnimatedBar />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
    <Grid Name="TaskArea" Grid.Column="4" ClipToBounds="True">
