                      <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                      <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <TextBlock Name="NetPrimaryLabel" Grid.Row="0" Text="SSID" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Name="NetPrimaryValue" Grid.Row="0" Grid.Column="1" Text="—" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="Link speed" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Name="NetSpeed" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="Signal strength" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Name="NetSignalStrength" Grid.Row="2" Grid.Column="1" Text="—" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Text="IPv4 address" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Name="NetLocalIp" Grid.Row="3" Grid.Column="1" Text="—" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Text="Gateway" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Name="NetGateway" Grid.Row="4" Grid.Column="1" Text="—" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="5" Text="DNS" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Name="NetDns" Grid.Row="5" Grid.Column="1" Text="—" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="6" Text="Public IP" Foreground="#D2FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Name="NetPublicIp" Grid.Row="6" Grid.Column="1" Text="—" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </ScrollViewer>
              <!-- more below: the last 16 DIP of the body fade into the footer (not over the scrollbar); shown only while scrollable -->
              <Rectangle Name="NetworkBodyFade" Grid.Row="1" Height="16" VerticalAlignment="Bottom" Margin="0,0,14,0" Fill="{DynamicResource TB.NetworkFooter}" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#FF000000" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.OpacityMask>
              </Rectangle>
              <Border Grid.Row="2" Background="{DynamicResource TB.NetworkFooter}" BorderBrush="#32FFFFFF" BorderThickness="0,1,0,0" Padding="11,6,11,4">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="25" /></Grid.RowDefinitions>
                  <Grid Name="NetworkActionGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Name="WifiSettingsButton" Grid.Column="0" Style="{StaticResource MetroSoundActionTile}" Background="{DynamicResource TB.NetworkWifiTile}" Margin="0,0,4,0" Click="OnOpenWifiSettings" ToolTip="Wi-Fi settings">
                      <Grid Margin="6,5,6,5"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" MinHeight="30" /></Grid.RowDefinitions><Viewbox Grid.Row="0" Style="{StaticResource MetroSoundActionIcon}"><Canvas Width="32" Height="32"><Path Data="F0 M 13,1 L 19,1 L 19.8,5.1 L 22.1,6 L 25.6,3.6 L 29.4,7.4 L 27,10.9 L 27.9,13.2 L 31,14 L 31,18 L 27.9,18.8 L 27,21.1 L 29.4,24.6 L 25.6,28.4 L 22.1,26 L 19.8,26.9 L 19,31 L 13,31 L 12.2,26.9 L 9.9,26 L 6.4,28.4 L 2.6,24.6 L 5,21.1 L 4.1,18.8 L 1,18 L 1,14 L 4.1,13.2 L 5,10.9 L 2.6,7.4 L 6.4,3.6 L 9.9,6 L 12.2,5.1 Z M 16,11 A 5,5 0 1 0 16,21 A 5,5 0 1 0 16,11 Z" Fill="{DynamicResource TB.Ink}" /></Canvas></Viewbox><TextBlock Name="WifiSettingsLabel" Grid.Row="1" Text="Wi-Fi settings" FontFamily="Segoe UI" FontSize="12" LineHeight="15" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,10,1" /><Path Grid.Row="1" Style="{StaticResource MetroSoundActionChevron}" Margin="0,0,0,3" /></Grid>
