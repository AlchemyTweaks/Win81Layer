                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TB.Ink}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="&#187;" Foreground="{DynamicResource TB.InkSoft}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
