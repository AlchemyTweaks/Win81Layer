                    <TextBlock Name="NetAdapter" Text="Detecting network adapter..." Foreground="#C4FFFFFF" FontFamily="Segoe UI" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,1,0,0" />
                  </StackPanel>
                  <TextBlock Name="NetRefreshStatus" Grid.Column="2" Text="Updating..." Foreground="#B8FFFFFF" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Top" Margin="8,3,0,0" Visibility="Collapsed" />
                </Grid>
              </Border>
              <ScrollViewer Name="NetworkBodyScroll" Grid.Row="1" ScrollChanged="OnFlyoutBodyScrollChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" IsManipulationEnabled="True" Padding="13,7,9,6" PanningMode="VerticalOnly" PanningDeceleration="0.0025" PanningRatio="1.0">
                <ScrollViewer.Resources>
                  <Style TargetType="{x:Type ScrollBar}">
