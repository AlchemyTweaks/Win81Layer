<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Win81Layer" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Fallbacks only; TaskbarContextMenu.ApplyTheme overwrites these live per menu. VM-authentic Build 9600 values. -->
  <SolidColorBrush x:Key="M.Bg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="M.Fg" Color="#000000" />
  <SolidColorBrush x:Key="M.Dis" Color="#767676" />
  <SolidColorBrush x:Key="M.Hover" Color="#DEDEDE" />
  <SolidColorBrush x:Key="M.HoverBorder" Color="Transparent" />
  <SolidColorBrush x:Key="M.Border" Color="#000000" />
  <SolidColorBrush x:Key="M.Sep" Color="#C8C8C8" />
  <SolidColorBrush x:Key="M.Arrow" Color="#000000" />
  <!-- Keyboard-highlighted row (inverts in both themes); TaskbarContextMenu.ApplyTheme overwrites these live per menu. -->
  <SolidColorBrush x:Key="M.KbBg" Color="#000000" />
  <SolidColorBrush x:Key="M.KbFg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="M.KbGesture" Color="#C8C8C8" />
  <!-- A toggle's Off track, its outline and its outline on the keyboard row, and the shortcut text; normally the Off track
       uses M.Dis and the track has no outline (Dark rest gives them their own values). -->
  <SolidColorBrush x:Key="M.ToggleOff" Color="#767676" />
  <SolidColorBrush x:Key="M.ToggleBorder" Color="Transparent" />
  <SolidColorBrush x:Key="M.KbToggleBorder" Color="Transparent" />
  <SolidColorBrush x:Key="M.Gesture" Color="#616161" />
  <!-- The menu border (2 in light, the authentic 8.1 Content Menu; 1 in dark, Dark rest and glass) and the submenu offsets
       that make the first submenu row line up with its parent row and the two borders meet in one seam. ApplyTheme sets
       them per menu next to the palette. -->
  <Thickness x:Key="M.BorderThickness">2</Thickness>
  <sys:Double x:Key="M.SubOffsetX">-2</sys:Double>
  <sys:Double x:Key="M.SubOffsetY">-6</sys:Double>
  <Style x:Key="Win81Separator" TargetType="{x:Type Separator}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Height="1" Background="{DynamicResource M.Sep}" Margin="8,3" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The command rows build no popup or chevron: the style picks the submenu template (below) only for rows that
       have a submenu, so a plain row instantiates fewer elements. Both share one layout. -->
  <ControlTemplate x:Key="Win81MenuItemLeafTemplate" TargetType="{x:Type MenuItem}">
    <!-- A command row: the submenu row's layout (below) without its popup and chevron. -->
    <Border Name="Bd" MinHeight="32" Background="#00FFFFFF" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Grid MinHeight="28" MinWidth="160">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" MinWidth="32" SharedSizeGroup="M81Right" />
        </Grid.ColumnDefinitions>
        <ContentPresenter Name="IconHost" Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
        <Path Name="Check" Grid.Column="0" Data="{x:Static local:MenuGlyphs.Tick}" Width="12" Height="10" Stretch="None" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Ellipse Name="Radio" Grid.Column="0" Width="6" Height="6" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,0,0,0" />
        <Grid Name="Toggle" Grid.Column="2" Width="28" Height="14" Margin="0,0,10,0" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Name="Track" Background="{DynamicResource M.ToggleOff}" BorderBrush="{DynamicResource M.ToggleBorder}" BorderThickness="1" SnapsToDevicePixels="True" />
          <Border Name="Knob" Width="8" Margin="2" Background="{DynamicResource M.Fg}" HorizontalAlignment="Left" SnapsToDevicePixels="True" />
        </Grid>
        <TextBlock Name="Gesture" Grid.Column="2" Text="{Binding InputGestureText, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource M.Gesture}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,10,0" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="MenuItem.IsChecked" Value="True">
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <MultiTrigger>
        <!-- a mutually-exclusive choice shows a filled 6 px bullet instead of the tick -->
        <MultiTrigger.Conditions>
          <Condition Property="FrameworkElement.Tag" Value="radio" />
          <Condition Property="MenuItem.IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Radio" Property="Visibility" Value="Visible" />
      </MultiTrigger>
      <Trigger Property="FrameworkElement.Tag" Value="toggle">
        <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
        <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="FrameworkElement.Tag" Value="toggle" />
          <Condition Property="MenuItem.IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Track" Value="{DynamicResource MenuAccent}" Property="Border.Background" />
        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
      </MultiTrigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="Bd" Value="{DynamicResource M.Hover}" Property="Border.Background" />
        <Setter TargetName="Bd" Value="{DynamicResource M.HoverBorder}" Property="Border.BorderBrush" />
      </Trigger>
      <MultiTrigger>
        <!-- Pattern 7: the keyboard-highlighted Content-Menu item INVERTS to solid black. -->
        <MultiTrigger.Conditions>
          <Condition Property="MenuItem.IsHighlighted" Value="True" />
          <Condition Property="UIElement.IsMouseOver" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource M.KbBg}" />
        <Setter Property="Foreground" Value="{DynamicResource M.KbFg}" />
        <Setter TargetName="Gesture" Property="TextBlock.Foreground" Value="{DynamicResource M.KbGesture}" />
        <!-- Keep the toggle knob readable on the inverted (white in dark) highlight bar; the checked-state
             Track=MenuAccent above is left intact since we only retarget the knob, not the track. -->
        <Setter TargetName="Knob" Property="Border.Background" Value="{DynamicResource M.KbFg}" />
        <Setter TargetName="Track" Property="Border.BorderBrush" Value="{DynamicResource M.KbToggleBorder}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Value="{DynamicResource M.Dis}" Property="Foreground" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="Win81MenuItemSubmenuTemplate" TargetType="{x:Type MenuItem}">
    <!-- 32 DIP rows, exactly 40 px at 125% and 48 px at 150%: the row height sits on the item border itself (its
         1 px transparent edge rounds to 1 or 2 device pixels), the grid only keeps a floor. The right column is
         shared across the menu (M81Right), so shortcuts, toggles and chevrons line up in one column. -->
    <Border Name="Bd" MinHeight="32" Background="#00FFFFFF" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Grid MinHeight="28" MinWidth="160">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" MinWidth="32" SharedSizeGroup="M81Right" />
        </Grid.ColumnDefinitions>
        <ContentPresenter Name="IconHost" Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
        <Path Name="Check" Grid.Column="0" Data="{x:Static local:MenuGlyphs.Tick}" Width="12" Height="10" Stretch="None" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Ellipse Name="Radio" Grid.Column="0" Width="6" Height="6" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="4,0,0,0" />
        <Path Name="Arrow" Grid.Column="2" Data="{x:Static local:MenuGlyphs.Chevron}" Width="6" Height="10" Stretch="None" Stroke="{DynamicResource M.Arrow}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" />
        <Grid Name="Toggle" Grid.Column="2" Width="28" Height="14" Margin="0,0,10,0" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Name="Track" Background="{DynamicResource M.ToggleOff}" BorderBrush="{DynamicResource M.ToggleBorder}" BorderThickness="1" SnapsToDevicePixels="True" />
          <Border Name="Knob" Width="8" Margin="2" Background="{DynamicResource M.Fg}" HorizontalAlignment="Left" SnapsToDevicePixels="True" />
        </Grid>
        <TextBlock Name="Gesture" Grid.Column="2" Text="{Binding InputGestureText, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Foreground="{DynamicResource M.Gesture}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,10,0" />
        <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="{DynamicResource M.SubOffsetX}" VerticalOffset="{DynamicResource M.SubOffsetY}" Focusable="False" PopupAnimation="None" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
          <Border Background="{DynamicResource M.Bg}" BorderBrush="{DynamicResource M.Border}" BorderThickness="{DynamicResource M.BorderThickness}" Padding="0,3" Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="MenuItem.Role" Value="SubmenuHeader">
        <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
        <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="MenuItem.IsChecked" Value="True">
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
        <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <MultiTrigger>
        <!-- a mutually-exclusive choice shows a filled 6 px bullet instead of the tick -->
        <MultiTrigger.Conditions>
          <Condition Property="FrameworkElement.Tag" Value="radio" />
          <Condition Property="MenuItem.IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Radio" Property="Visibility" Value="Visible" />
      </MultiTrigger>
      <Trigger Property="FrameworkElement.Tag" Value="toggle">
        <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
        <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="FrameworkElement.Tag" Value="toggle" />
          <Condition Property="MenuItem.IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Track" Value="{DynamicResource MenuAccent}" Property="Border.Background" />
        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
      </MultiTrigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="Bd" Value="{DynamicResource M.Hover}" Property="Border.Background" />
        <Setter TargetName="Bd" Value="{DynamicResource M.HoverBorder}" Property="Border.BorderBrush" />
      </Trigger>
      <MultiTrigger>
        <!-- Pattern 7: the keyboard-highlighted Content-Menu item INVERTS to solid black. -->
        <MultiTrigger.Conditions>
          <Condition Property="MenuItem.IsHighlighted" Value="True" />
          <Condition Property="UIElement.IsMouseOver" Value="False" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Bd" Property="Border.Background" Value="{DynamicResource M.KbBg}" />
        <Setter Property="Foreground" Value="{DynamicResource M.KbFg}" />
        <Setter TargetName="Arrow" Property="Shape.Stroke" Value="{DynamicResource M.KbFg}" />
        <Setter TargetName="Gesture" Property="TextBlock.Foreground" Value="{DynamicResource M.KbGesture}" />
        <!-- Keep the toggle knob readable on the inverted (white in dark) highlight bar; the checked-state
             Track=MenuAccent above is left intact since we only retarget the knob, not the track. -->
        <Setter TargetName="Knob" Property="Border.Background" Value="{DynamicResource M.KbFg}" />
        <Setter TargetName="Track" Property="Border.BorderBrush" Value="{DynamicResource M.KbToggleBorder}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Value="{DynamicResource M.Dis}" Property="Foreground" />
        <Setter TargetName="Arrow" Value="{DynamicResource M.Dis}" Property="Shape.Stroke" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Win81MenuItem" TargetType="{x:Type MenuItem}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource M.Fg}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource Win81MenuItem}" />
    <Setter Property="Template" Value="{StaticResource Win81MenuItemLeafTemplate}" />
    <Style.Triggers>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter Property="Template" Value="{StaticResource Win81MenuItemSubmenuTemplate}" />
      </Trigger>
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter Property="Template" Value="{StaticResource Win81MenuItemSubmenuTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- A caption row (the jump list's "Recent"): not a command, so no hover, focus or 32 DIP floor; 28 DIP tall (whole
       pixels at 125% and 150%), the text on the header column of the command rows (1 edge + 24 icon column + 4). -->
  <Style x:Key="Win81MenuCaption" TargetType="{x:Type MenuItem}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border Height="28" Background="#00FFFFFF" Padding="29,0,10,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Win81ContextMenu" TargetType="{x:Type ContextMenu}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
    <Setter Property="ContextMenu.HasDropShadow" Value="False" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="ItemContainerStyle" Value="{DynamicResource Win81MenuItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{DynamicResource M.Bg}" BorderBrush="{DynamicResource M.Border}" BorderThickness="{DynamicResource M.BorderThickness}" Padding="0,3" Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
